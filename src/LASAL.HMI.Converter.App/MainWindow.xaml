<Window x:Class="LASAL.HMI.Converter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LASAL HMI Converter — SIGMATEK LASAL SCREEN to VISUDesigner"
        Height="860" Width="1400" MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="6,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}"/>
            <Setter Property="RowBackground" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrushTheme}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Rail -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="14,16,14,12">
                    <TextBlock Text="LASAL HMI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="CONVERTER STUDIO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    <TextBlock Text="LASAL SCREEN &#x2192; VISUDesigner" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14">
                    <Button Content="Toggle Dark / Light Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="v1.0.0 | x64 + 32-bit COM Bridge" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="1. Dashboard / Home" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="2. New Conversion (Wizard)" Command="{Binding NavigateCommand}" CommandParameter="NewConversion" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="3. Project Inspector" Command="{Binding NavigateCommand}" CommandParameter="Inspector" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="4. Object Mapping" Command="{Binding NavigateCommand}" CommandParameter="ObjectMapping" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="5. Datapoint Mapping" Command="{Binding NavigateCommand}" CommandParameter="DatapointMapping" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="6. Asset Manager" Command="{Binding NavigateCommand}" CommandParameter="AssetManager" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="7. Conversion Preview" Command="{Binding NavigateCommand}" CommandParameter="Preview" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="8. Validation" Command="{Binding NavigateCommand}" CommandParameter="Validation" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="9. Conversion Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="10. Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="11. Documentation" Command="{Binding NavigateCommand}" CommandParameter="Documentation" Style="{StaticResource NavButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="0,0,0,1" Padding="20,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding SectionTitle}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SummaryKpiText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Extract &amp; Inspect" Command="{Binding ExtractInspectCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Convert Now" Command="{Binding RunConversionCommand}" Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Active Section Content Host -->
            <Grid Grid.Row="1" Margin="18">

                <!-- VIEW 1: DASHBOARD -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Dashboard">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock Text="Installed SIGMATEK Software Environment" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="LASAL SCREEN (Source COM)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding EnvironmentReport.LasalScreenVersion}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4"/>
                                        <TextBlock Text="{Binding EnvironmentReport.LasalScreenProgId}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="LASAL VISUDesigner (Target)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding EnvironmentReport.VisuDesignerVersion}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4"/>
                                        <TextBlock Text="Python 3.12 lvd Scripting Active" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="LASAL CLASS 2 / MachineManager" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding EnvironmentReport.LasalClass2Version}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4"/>
                                        <TextBlock Text="LARS Status: Detected Dynamically" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Quick Start — Launch Migration" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Original LASAL SCREEN (.lpr) and CLASS 2 (.lcp) projects are never modified. All automation runs on an isolated SHA-256 verified short-path staging copy." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Open 6-Step Conversion Wizard" Command="{Binding NavigateCommand}" CommandParameter="NewConversion" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"/>
                                        <Button Content="Re-Scan Environment" Command="{Binding RefreshEnvironmentCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                                        <Button Content="Open Target Folder" Command="{Binding OpenTargetFolderCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Live Engineering Log Stream" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ListBox ItemsSource="{Binding LiveLogs}" Height="240" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" FontFamily="Consolas" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 2: NEW CONVERSION (6-STEP WIZARD) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="NewConversion">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <DockPanel>
                        <!-- Wizard Step Header -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <Run Text="Step "/>
                                <Run Text="{Binding WizardStep, Mode=OneWay}"/>
                                <Run Text=" / 6:  (1) Source .lpr  &#x2192;  (2) CLASS 2  &#x2192;  (3) Target Output  &#x2192;  (4) Options  &#x2192;  (5) Pre-Flight  &#x2192;  (6) Execute &amp; Review"/>
                            </TextBlock>
                        </Border>

                        <!-- Wizard Footer Navigation -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="&#x2190; Back" Command="{Binding WizardBackCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="110"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Cancel" Command="{Binding CancelConversionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="Start Conversion" Command="{Binding RunConversionCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="Next &#x2192;" Command="{Binding WizardNextCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="110"/>
                                </StackPanel>
                                <Grid/>
                            </DockPanel>
                        </Border>

                        <!-- Wizard Step Panels -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <ScrollViewer>
                                <StackPanel>
                                    <!-- Step 1: Source .lpr -->
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Step 1: Source SIGMATEK LASAL SCREEN Project (.lpr)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse .lpr..." Command="{Binding BrowseSourceLprCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                                            <TextBox Text="{Binding SourceLprPath, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Step 2: Optional CLASS 2 -->
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Step 2: Companion LASAL CLASS 2 Project (.lsm / .lcp) [Optional]" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseClass2Command}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                                            <TextBox Text="{Binding Class2ProjectPath, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Step 3: Target Output -->
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Step 3: Target VISUDesigner Output Directory" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse Folder..." Command="{Binding BrowseTargetDirCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                                            <TextBox Text="{Binding TargetOutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Step 4: Resolution & Conversion Options -->
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Step 4: Resolution Scaling &amp; Migration Options" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Resolution Mode (Original or Custom):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ComboBox Width="160" SelectedValue="{Binding ResolutionMode}" SelectedValuePath="Content">
                                                <ComboBoxItem Content="Original"/>
                                                <ComboBoxItem Content="Custom"/>
                                            </ComboBox>
                                            <TextBlock Text="Width:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                            <TextBox Text="{Binding CustomTargetWidth}" Width="70"/>
                                            <TextBlock Text="Height:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                            <TextBox Text="{Binding CustomTargetHeight}" Width="70"/>
                                        </StackPanel>
                                        <CheckBox Content="Preserve Aspect Ratio when scaling" IsChecked="{Binding PreserveAspectRatio}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2"/>
                                        <CheckBox Content="Convert BMP transparency key color (#FF00FF) to 32-bit RGBA PNG alpha" IsChecked="{Binding ConvertBmpTransparency}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2"/>
                                        <CheckBox Content="Publish HTML5/JS Webroot automatically after generation (lvd.PublishProject)" IsChecked="{Binding PublishWebroot}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2"/>
                                    </StackPanel>

                                    <!-- Step 5 & 6: Live Execution Status & Logs -->
                                    <StackPanel>
                                        <TextBlock Text="Step 5 &amp; 6: Pre-Flight Extraction &amp; Execution Progress" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="18" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding ProgressMessage}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding LastValidationSummaryText}" Margin="0,0,0,10"/>
                                        <ListBox ItemsSource="{Binding LiveLogs}" Height="160" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Consolas" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- VIEW 3: PROJECT INSPECTOR -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Inspector">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Screens, Global &amp; Windows" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding InspectorScreens}" SelectedItem="{Binding SelectedInspectorScreen}" DisplayMemberPath="Name" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </DockPanel>
                    </Border>
                    <DataGrid Grid.Column="1" ItemsSource="{Binding SelectedInspectorScreen.Controls}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Control Name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Source Type" Binding="{Binding SourceType}" Width="130"/>
                            <DataGridTextColumn Header="Target VISU Control" Binding="{Binding TargetVisuType}" Width="190"/>
                            <DataGridTextColumn Header="X" Binding="{Binding X}" Width="55"/>
                            <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="55"/>
                            <DataGridTextColumn Header="W" Binding="{Binding Width}" Width="55"/>
                            <DataGridTextColumn Header="H" Binding="{Binding Height}" Width="55"/>
                            <DataGridTextColumn Header="Datapoint" Binding="{Binding DatapointId}" Width="200"/>
                            <DataGridTextColumn Header="Text / Fallback" Binding="{Binding StaticTextFallback}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- VIEW 4: OBJECT MAPPING -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="ObjectMapping">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Export Mapping Rules JSON" Command="{Binding ExportMappingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Import Custom Mapping Rules" Command="{Binding ImportMappingsCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding MappingRules}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Source Element Type" Binding="{Binding SourceType}" Width="180"/>
                                <DataGridTextColumn Header="Target VISUDesigner Control ID" Binding="{Binding TargetVisuControlId}" Width="240"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160"/>
                                <DataGridTextColumn Header="Support" Binding="{Binding SupportLevel}" Width="90"/>
                                <DataGridTextColumn Header="Mapping Behavior" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>

                <!-- VIEW 5: DATAPOINT MAPPING -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="DatapointMapping">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Filter Datapoints:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding DatapointSearchFilter, UpdateSourceTrigger=PropertyChanged}" Width="320"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding FilteredDatapoints}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="St#" Binding="{Binding StationNumber}" Width="50"/>
                                <DataGridTextColumn Header="Symbol Path" Binding="{Binding SymbolPath}" Width="260"/>
                                <DataGridTextColumn Header="CLASS 2 Class" Binding="{Binding ClassName}" Width="160"/>
                                <DataGridTextColumn Header="LSE Type" Binding="{Binding LseVarType}" Width="110"/>
                                <DataGridTextColumn Header="VISU Type" Binding="{Binding VisuDataType}" Width="100"/>
                                <DataGridTextColumn Header="Refresh (ms)" Binding="{Binding RefreshTimeMs}" Width="90"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding UnitId}" Width="110"/>
                                <DataGridTextColumn Header="Min" Binding="{Binding MinLimit}" Width="75"/>
                                <DataGridTextColumn Header="Max" Binding="{Binding MaxLimit}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>

                <!-- VIEW 6: ASSET MANAGER -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="AssetManager">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <DataGrid ItemsSource="{Binding Assets}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="180"/>
                            <DataGridTextColumn Header="Original File" Binding="{Binding OriginalFileName}" Width="200"/>
                            <DataGridTextColumn Header="Target Resource File" Binding="{Binding TargetFileName}" Width="200"/>
                            <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="80"/>
                            <DataGridTextColumn Header="Width" Binding="{Binding Width}" Width="70"/>
                            <DataGridTextColumn Header="Height" Binding="{Binding Height}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Transparency Converted" Binding="{Binding HasTransparencyKey, Mode=OneWay}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- VIEW 7: CONVERSION PREVIEW -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Preview">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Select Screen / Window Preview:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding ValidationComparisons}" SelectedItem="{Binding SelectedValidationScreen}" DisplayMemberPath="ScreenName" Width="280"/>
                            <TextBlock Text="{Binding SelectedValidationScreen.VisualSimilarityPercent, StringFormat='  Visual Similarity: {0:F2}%'}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Source LASAL SCREEN Layout" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Image Source="{Binding SourcePreviewImage}" Stretch="Uniform"/>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="8,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Target VISUDesigner Layout" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Image Source="{Binding TargetPreviewImage}" Stretch="Uniform"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- VIEW 8: VALIDATION -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Validation">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <TextBlock Text="{Binding LastValidationSummaryText}" FontWeight="SemiBold"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding ValidationComparisons}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Screen / Window" Binding="{Binding ScreenName}" Width="220"/>
                                <DataGridCheckBoxColumn Header="Window?" Binding="{Binding IsWindow, Mode=OneWay}" Width="80"/>
                                <DataGridTextColumn Header="Source Controls" Binding="{Binding SourceControlCount}" Width="120"/>
                                <DataGridTextColumn Header="Target Controls" Binding="{Binding TargetControlCount}" Width="120"/>
                                <DataGridCheckBoxColumn Header="Target JSON Exists" Binding="{Binding TargetFileExists, Mode=OneWay}" Width="130"/>
                                <DataGridTextColumn Header="Visual Similarity (%)" Binding="{Binding VisualSimilarityPercent}" Width="150"/>
                                <DataGridTextColumn Header="Max Geometry Delta (px)" Binding="{Binding MaxGeometryDeltaPx}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>

                <!-- VIEW 9: CONVERSION REPORTS -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Reports">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="17-Section Conversion Reports" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Every conversion automatically generates four synchronized report formats containing inventory, mapping tables, warnings, visual comparison metrics, and manual review checklists." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Open HTML Report" Command="{Binding OpenReportFileCommand}" CommandParameter="{Binding LastResult.ReportFiles.HtmlReportPath}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"/>
                                <Button Content="Open Excel (.xlsx)" Command="{Binding OpenReportFileCommand}" CommandParameter="{Binding LastResult.ReportFiles.ExcelReportPath}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                                <Button Content="Open CSV Objects" Command="{Binding OpenReportFileCommand}" CommandParameter="{Binding LastResult.ReportFiles.CsvReportPath}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                                <Button Content="Open JSON Report" Command="{Binding OpenReportFileCommand}" CommandParameter="{Binding LastResult.ReportFiles.JsonReportPath}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LastResult.ReportFiles.HtmlReportPath, StringFormat='HTML: {0}'}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                            <TextBlock Text="{Binding LastResult.ReportFiles.ExcelReportPath, StringFormat='XLSX: {0}'}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                            <TextBlock Text="{Binding LastResult.ReportFiles.CsvReportPath, StringFormat='CSV:  {0}'}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                            <TextBlock Text="{Binding LastResult.ReportFiles.JsonReportPath, StringFormat='JSON: {0}'}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- VIEW 10: SETTINGS -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Application &amp; Toolchain Preferences" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <CheckBox Content="Dark Industrial Engineering Theme (Uncheck for Light Theme)" IsChecked="{Binding IsDarkTheme}" Command="{Binding ToggleThemeCommand}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4"/>
                            <CheckBox Content="Convert BMP Transparent Key Pixels (#FF00FF) to PNG Alpha" IsChecked="{Binding ConvertBmpTransparency}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4"/>
                            <CheckBox Content="Automatically Publish VISUDesigner HTML5 Webroot after Conversion" IsChecked="{Binding PublishWebroot}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- VIEW 11: DOCUMENTATION -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Documentation">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Technical Docs" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding DocFileNames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Command="{Binding DataContext.LoadDocCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource NavButtonStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBox Grid.Column="1" Text="{Binding SelectedDocContent, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </Grid>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="0,1,0,0" Padding="16,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ProgressMessage}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat='Progress: {0}%'}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                    <Grid/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
