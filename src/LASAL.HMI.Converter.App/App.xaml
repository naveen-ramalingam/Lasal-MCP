<Application x:Class="LASAL.HMI.Converter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#111827"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B"/>
            <SolidColorBrush x:Key="BorderBrushTheme" Color="#334155"/>
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#38BDF8"/>
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
