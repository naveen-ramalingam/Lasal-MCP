FUNCTION VIRTUAL GLOBAL PumpControl::CyWork
	VAR_INPUT
		EAX 	: UDINT;
	END_VAR
	VAR_OUTPUT
		state (EAX) 	: UDINT;
	END_VAR
  
  // read Inputs
  ActFillLevel := ActFillLevel.Read();
  WaterTemp := WaterTemp.Read();
  
  // Switch off cablebreak
  if ActFillLevel < 0 then
    ActFillLevel := 50000;
  end_if;

  // Alarm Handling
  if ActFillLevel > MaxAlarm then
    _AlarmX1Para1.ClassSvr.Write(input:= 1);
  elsif ActFillLevel < MinAlarm then
    _AlarmX1Para2.ClassSvr.Write(input:= 1);
  else
    _AlarmX1Para1.ClassSvr.Write(input:= 0);
    _AlarmX1Para2.ClassSvr.Write(input:= 0);
  end_if;
  
  if MaxBorder <= MinBorder then
    _AlarmX2Para1.ClassSvr.Write(input:= 1);
  else
    _AlarmX2Para1.ClassSvr.Write(input:= 0);
  end_if;
  
  // PumpControl Logic 
  if ActFillLevel >= MaxBorder then
    Pump := 1;
  elsif ActFillLevel <= MinBorder then
    Pump := 0;
  end_if;

  // write Outputs
  Pump.Write (Pump);

	state := READY;

END_FUNCTION


