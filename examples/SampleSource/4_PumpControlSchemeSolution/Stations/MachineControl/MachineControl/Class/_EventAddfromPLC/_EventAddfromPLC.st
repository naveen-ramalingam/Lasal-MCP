  	tmpEvent : _PLCEventdata;
  END_VAR
  
  InitPLCEventdata(pPLCEvent:=#tmpEvent);

  // add event for change of value
  tmpEvent.EventType := EVENT_VALUECHANGE;

  // store information
  tmpEvent.no_para := 3;
  tmpEvent.para1   := udLasalID$DINT;
  tmpEvent.para2   := dOldValue;
