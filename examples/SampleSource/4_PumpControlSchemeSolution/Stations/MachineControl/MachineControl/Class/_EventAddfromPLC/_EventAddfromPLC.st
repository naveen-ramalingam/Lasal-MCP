		bUnicode 	 : BOOL;
	END_VAR
  VAR
  	tmpEvent : _PLCEventdata;
  END_VAR
  
  InitPLCEventdata(pPLCEvent:=#tmpEvent);

  tmpEvent.EventType := EVENT_EVENTENTRY;
  
  // store information
  tmpEvent.no_para := 3;
  tmpEvent.para1   := to_dint(uiCategory);
  tmpEvent.para2   := to_dint(uiIndex);
  tmpEvent.para3   := bUnicode;
  tmpEvent.para4   := config$DINT;
  
  if ( (pText <> NIL) & (uiSize < (sizeof(tmpEvent.aString) -1)) ) then
  
    tmpEvent.StringSize := uiSize;
    _memcpy(ptr1:=#tmpEvent.aString[0], ptr2:=pText, cntr:=uiSize);
       
  end_if;

  SendData(pData:=#tmpEvent$^void, length:=sizeof(tmpEvent), timeout:=1000, OptCMD:=0);
  
END_FUNCTION


