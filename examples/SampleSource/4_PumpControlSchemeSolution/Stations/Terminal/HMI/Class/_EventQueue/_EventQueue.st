//-------------------------------------------------------------------------------------------------
FUNCTION _EventQueue::NewInst_AddValueChange
	VAR_INPUT
		udVarNo 	: DINT;
		dOldValue 	: DINT;
		dNewValue 	: DINT;
	END_VAR
	VAR_OUTPUT
		ret_code 	: IprStates;
	END_VAR

	ret_code := READY;

  AddValueChange( udVarNo   := udVarNo$UDINT, 
                  dOldValue := dOldValue, 
                  dNewValue := dNewValue );

END_FUNCTION

//-------------------------------------------------------------------------------------------------
//  Cmd 06: AddOPChange
//-------------------------------------------------------------------------------------------------
FUNCTION _EventQueue::NewInst_AddOPChange
	VAR_INPUT
		eOPMode 	: DINT;
	END_VAR
	VAR_OUTPUT
		ret_code 	: IprStates;
	END_VAR

	ret_code := READY;

  AddOPChange(eOPMode := eOPMode$t_e_OPMode);

END_FUNCTION

//-------------------------------------------------------------------------------------------------
//  Cmd 07: AddUserLoginLogout
//-------------------------------------------------------------------------------------------------
FUNCTION _EventQueue::NewInst_AddUserLoginLogout
	VAR_INPUT
		pUserName 	: DINT;
		dActLevel 	: DINT;
		bIsLogin 	: DINT;
	END_VAR
	VAR_OUTPUT
		ret_code 	: IprStates;
	END_VAR

	ret_code := READY;

  AddUserLoginLogout( pUserName := pUserName$^CHAR, 
                      dActLevel := dActLevel, 
                      bIsLogin  := TO_BOOL(bIsLogin) );

END_FUNCTION

