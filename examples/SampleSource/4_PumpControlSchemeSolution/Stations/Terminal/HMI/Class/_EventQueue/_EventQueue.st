		NewInst_AddMenuChange:
			ret_code := NewInst_AddMenuChange(pPara^.aPara[0],pPara^.aPara[1],pPara^.aPara[2],pPara^.aPara[3]);
			pResult^.uiLng := 0 + sizeof(pResult^.uiLng);
		NewInst_AddValueChange:
			ret_code := NewInst_AddValueChange(pPara^.aPara[0],pPara^.aPara[1],pPara^.aPara[2]);
			pResult^.uiLng := 0 + sizeof(pResult^.uiLng);
		NewInst_AddOPChange:
			ret_code := NewInst_AddOPChange(pPara^.aPara[0]);
			pResult^.uiLng := 0 + sizeof(pResult^.uiLng);
		NewInst_AddUserLoginLogout:
			ret_code := NewInst_AddUserLoginLogout(pPara^.aPara[0],pPara^.aPara[1],pPara^.aPara[2]);
			pResult^.uiLng := 0 + sizeof(pResult^.uiLng);
	ELSE

	ret_code := READY;
	END_CASE;


END_FUNCTION
