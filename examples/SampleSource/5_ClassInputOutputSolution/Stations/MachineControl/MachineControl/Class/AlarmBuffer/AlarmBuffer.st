FUNCTION VIRTUAL AlarmBuffer::OPModeChange
	VAR_INPUT
		eActOPMode 	: t_e_OPMode;
		eNewOPMode 	: t_e_OPMode;
	END_VAR
	VAR_OUTPUT
		bOK 	: BOOL;
	END_VAR
  
  bOK := true;

  //*****************************************************************************
  //** UNTERSCHEIDUNG FÜR NEUEN BETRIEBSMODUS                                  **
  //*****************************************************************************

  // je nachdem in welchen Betriebsmodus gewechselt werden soll, müssen die 
  // Alarme geprüft werden. Ein Alarm kann einen Wechsel in einen anderen
  // Betriebsmodus verhindern.
  // aktueller Betriebsmodus = Manual
  // neuer Betriebsmodus = Automatik
  // Alarm mit der Gruppe SemiAutomatik aktiv
  // => Umschalten wird verhindert
  
  case eNewOPMode of
    
    // Betriebsart Init
    //***************************************************************************
    OPMode_Init:
    
      // in diesen Betriebsmodus kann immer gewechselt werden,
      // egal welche Alarme aktiv sind.
      
    
    // Betriebsart Homing
    //***************************************************************************
    OPMode_Homing:
      
      // in diesen Betriebsmodus kann immer gewechselt werden,
      // egal welche Alarme aktiv sind.
      
      
    // Betriebsmodus Stop
    //***************************************************************************        
    OPMode_Stop:
    
      // in diesen Betriebsmodus kann immer gewechselt werden,
      // egal welche Alarme aktiv sind.
      
      
    // Betriebsmodus Manual + Setup
    //***************************************************************************    
    OPMode_Manual, OPMode_Setup:

      // Prüfen ob Alarm der Gruppe Stop aktiv ist
      //------------------------------------------------------
      if sOPModeAlarm.udOPModeStop then
        bOK := false;
      end_if;


    // Betriebsmodus SemiAutomatic
    //***************************************************************************
    OPMode_SemiAuto:

      // Prüfen ob Alarm der Gruppe Stop oder Manual aktiv ist
      //------------------------------------------------------
      if  sOPModeAlarm.udOPModeStop | 
          sOPModeAlarm.udOPModeManual then
        bOK := false;
      end_if;
      
      
    // Betriebsmodus Automatic
    //***************************************************************************    
    OPMode_Automatic:
    
      // Prüfen ob Alarm der Gruppe Stop, Manual oder Halbautomatik aktiv ist
      //------------------------------------------------------
      if  sOPModeAlarm.udOPModeStop | 
          sOPModeAlarm.udOPModeManual | 
          sOPModeAlarm.udOPModeSemiAuto then
        bOK := false;
      end_if;
    
    // Betriebsmodus Error
    //***************************************************************************    
    OPMode_Error:
    
      // in diesen Betriebsmodus kann immer gewechselt werden,
      // egal welche Alarme aktiv sind.
      
    // nicht unterstützer Betriebsmodus
    //***************************************************************************
    else
      TRACE("AlarmBuffer::OPModeChange(): nicht unterstützter Betriebsmodus aktiv");
      bOK := false;
      
  end_case;

END_FUNCTION


FUNCTION VIRTUAL AlarmBuffer::OPModeActive
	VAR_INPUT
		eActOPMode 	: t_e_OPMode;
	END_VAR
	VAR_OUTPUT
		eNewOPMode 	: t_e_OPMode;
	END_VAR
  
  // Rückgabewert initialisieren
  // => kein Wechsel Betriebsmodus
  eNewOPMode := eActOPMode;
  
  //*****************************************************************************
  //** FÜR DEN AKTUELLEN BETRIEBSMODUS ALARME PRÜFEN                           **
  //*****************************************************************************
  
  // Die OPMode-Gruppe eines Alarmes definiert, in welchen Betriebsmodus 
  // gewechselt werden muss, wenn der Alarm auftritt. Dabei wird der Modus
  // Automatik am höchsten bewertet, der Modus Manual am niedrigsten.
  // Tritt daher im Modus SemiAuto ein Alarm der Gruppe Automatik auf, so
  // wird nicht gewechselt.
  
  case eActOPMode of
  
    // Betriebsmodus Init
    //***************************************************************************
    OPMode_Init:

      // im Betriebsmodus Init können Alarme auftreten, ohne dass der Modus 
      // gewechselt werden muss.
    
    // Betriebsmodus Stop
    //***************************************************************************
    OPMode_Stop:
    
      // im Betriebsmodus Stop können Alarme auftreten, ohne dass der Modus 
      // gewechselt werden muss.
      
      
    // Betriebsmodus Manual + Setup
    //***************************************************************************
    OPMode_Manual, OPMode_Setup:

      // Prüfen ob Alarm der Gruppe Stop aktiv ist
      //---------------------------------------------
      if sOPModeAlarm.udOPModeStop then
        eNewOPMode := OPMode_Stop;
      end_if;
      
      // Prüfen ob Alarm der Gruppe Error aktiv ist
      // --------------------------------------------
      if sOPModeAlarm.udOPModeError then
        eNewOPMode := OPMode_Error;
      end_if;


    // Betriebsmodus SemiAuto
    //***************************************************************************
    OPMode_SemiAuto:

      // Prüfen ob Alarm der Gruppe Stop aktiv ist
      //---------------------------------------------
      if sOPModeAlarm.udOPModeStop then
        eNewOPMode := OPMode_Stop;
        
      // Prüfen ob Alarm der Gruppe Manual aktiv ist
      //---------------------------------------------
      elsif sOPModeAlarm.udOPModeManual then
        eNewOPMode := OPMode_Manual;
        
      end_if;
    
    
    // Betriebsmodus Automatic
    //***************************************************************************
    OPMode_Automatic:
    
      // Prüfen ob Alarm der Gruppe Stop aktiv ist
      //---------------------------------------------
      if sOPModeAlarm.udOPModeStop then
        eNewOPMode := OPMode_Stop;
        
      // Prüfen ob Alarm der Gruppe Manual aktiv ist
      //---------------------------------------------
      elsif sOPModeAlarm.udOPModeManual then
        eNewOPMode := OPMode_Manual;
        
      // Prüfen ob Alarm der Gruppe SemiAuto aktiv ist
      //----------------------------------------------
      elsif sOPModeAlarm.udOPModeSemiAuto then
        eNewOPMode := OPMode_SemiAuto;
        
      end_if;
    
    
    // nicht unterstützer Betriebsmodus
    //***************************************************************************
    else
      TRACE("AlarmBuffer::CheckAlarm(): nicht unterstützter Betriebsmodus aktiv");
      eActOPMode := OPMode_Stop;
      
  end_case;

END_FUNCTION


