    AlarmInfo       := AlarmInfo.Read();
  
  else
    GroupInit       := 0;
    GroupHoming     := 0;
    GroupStop       := 0;
    GroupSetup      := 0;
    GroupManual     := 0;
    GroupSemiAuto   := 0;
    GroupAutomatic  := 0;
    GroupError      := 0;
    AlarmInfo       := 0;
  end_if;

  // store opmode informations
  pAlarms^.udOPModeInit       := GroupInit; 
  pAlarms^.udOPModeHoming     := GroupHoming;
  pAlarms^.udOPModeStop       := GroupStop;
  pAlarms^.udOPModeSetup      := GroupSetup;
  pAlarms^.udOPModeManual     := GroupManual;
  pAlarms^.udOPModeSemiAuto   := GroupSemiAuto;
  pAlarms^.udOPModeAutomatic  := GroupAutomatic;
  pAlarms^.udOPModeError      := GroupError;
  
  // store alarminfo
  pAlarmInfo^ := AlarmInfo;
  
  // set returncode
  bSuccessful := true;

