	END_VAR
	VAR_OUTPUT
		bSuccessful 	: BOOL;
	END_VAR

  // check input parameter
  if pAlarms = NIL | pAlarmInfo = NIL then
    bSuccessful := false;
    return;
  end_if;
  
  // check if station is active
  Active := Active.Read();
  if Active then
  
    // read client
    GroupInit       := GroupInit.Read();
    GroupHoming     := GroupHoming.Read();
    GroupStop       := GroupStop.Read();
    GroupSetup      := GroupSetup.Read();
