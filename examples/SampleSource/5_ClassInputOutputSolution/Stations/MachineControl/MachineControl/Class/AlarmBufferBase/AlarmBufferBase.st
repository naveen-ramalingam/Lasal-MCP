FUNCTION VIRTUAL GLOBAL AlarmBufferBase::Init
VAR
	tmpSize : DINT;
END_VAR

  // Call base-class
  _AlarmXBuffer::Init();
  
  // last init-run
  if _FirstScan then
  
    // get maximum number of additional parameter
    tmpSize := MAX_ALARMPARA;
    
    // check size of additional parameter
    if tmpSize < 5 then
      TRACE_ERR("Define MAX_ALARMPARA in AlarmXBuffer.h must be at least 5 => otherwise memoryleak");
    end_if;

  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL AlarmBufferBase::RegisterAlarmXPara
	VAR_INPUT
		pThis 	: ^void;
		config 	: UDINT;
		group 	: UDINT;
		no 	: UDINT;
		paras 	: ^UDINT;
	END_VAR
	VAR_OUTPUT
		retcode 	: UDINT;
	END_VAR
  VAR
  	tmpPara   : ^UDINT;
    tmpOPMode : t_e_OPMode;
  END_VAR

  // check if additional parameters are available
  if no >= 1 then
  
    // check OPMode
    //---------------------------------------------------------------------
    // check if configuration of pOPMode is already available
    if bsConfig.OPModeConfig = false then

      // check if client Parameter1 is connected
      if IsClientConnected(input := #Parameter1) then
        bsConfig.Parameter1Connected := true;
      end_if;
      
      // check if client Parameter2 is connected
      if IsClientConnected(input := #Parameter2) then
        bsConfig.Parameter2Connected := true;
      end_if;

      pOPMode := coOPModeConfig.GetModeConfig();

      // check if configuration is valid
      if pOPMode <> NIL then
        bsConfig.OPModeConfig := true;
      else
        TRACE_ERR("AlarmBufferBase::RegisterAlarmXPara(): no configuration of OPMode available");
      end_if;
      
    end_if;

    // check if configured OPMode is available
    if bsConfig.OPModeConfig = true then
      
      // get selected OPMode
      tmpOPMode := (paras + (no - 1) * sizeof(UDINT))^$t_e_OPMode;
      
      // check if OPMode is available
      case tmpOPMode of
      
        //---------------------------------------------
        
        OPMode_Init:
          if pOPMode^.bOPModeInit = false then
            TRACE_ERR("AlarmBufferBase::RegisterAlarmXPara() OPMode_Init: invalid OPMode-configuration of alarm detected");
          end_if;

        //---------------------------------------------
        
        OPMode_Homing:
          if pOPMode^.bOPModeHoming = false then
            TRACE_ERR("AlarmBufferBase::RegisterAlarmXPara() OPMode_Homing: invalid OPMode-configuration of alarm detected");
          end_if;


        OPMode_Stop:
          if pOPMode^.bOPModeStop = false then
            TRACE_ERR("AlarmBufferBase::RegisterAlarmXPara() OPMode_Stop: invalid OPMode-configuration of alarm detected");
          end_if;
        
        //---------------------------------------------
        
        OPMode_Setup:
          if pOPMode^.bOPModeSetup = false then
            TRACE_ERR("AlarmBufferBase::RegisterAlarmXPara() OPMode_Setup: invalid OPMode-configuration of alarm detected");
          end_if;
        
        //---------------------------------------------

        OPMode_Manual:
          if pOPMode^.bOPModeManual = false then
            TRACE_ERR("AlarmBufferBase::RegisterAlarmXPara() OPMode_Manual: invalid OPMode-configuration of alarm detected");
          end_if;
        
        //---------------------------------------------

        OPMode_SemiAuto:
          if pOPMode^.bOPModeSemiAuto = false then
            TRACE_ERR("AlarmBufferBase::RegisterAlarmXPara() OPMode_SemiAuto: invalid OPMode-configuration of alarm detected");
          end_if;
        
        //---------------------------------------------

        OPMode_Automatic:
          if pOPMode^.bOPModeAutomatic = false then
            TRACE_ERR("AlarmBufferBase::RegisterAlarmXPara() OPMode_Automatic: invalid OPMode-configuration of alarm detected");
          end_if;
        
        //---------------------------------------------

        OPMode_Error:
          if pOPMode^.bOPModeError = false then
            TRACE_ERR("AlarmBufferBase::RegisterAlarmXPara() OPMode_Error: invalid OPMode-configuration of alarm detected");
          end_if;
        
        //---------------------------------------------
      
        else
          TRACE_ERR("AlarmBufferBase::RegisterAlarmXPara(): invalid operationmode detected");
      end_case;
    
    end_if;
    
    no -= 1;
    
    
    // Add Lasal ID of Parameter1 + Parameter2
    //---------------------------------------------------------------------
    // necessary, because the lse-kernel determines the configuration of
    // this connected dataserver (unit,...) Used to get the correct
    // formatting if the value is displayed on the screen.

    tmpPara := paras + no * sizeof(DINT);
    
    // check if Parameter 1 is connected
    if bsConfig.Parameter1Connected then
      tmpPara^ := (Parameter1.pCH)$UDINT;
      tmpPara += sizeof(DINT);
      no += 1;
    end_if;

    // check if Parameter 2 is connected
    if bsConfig.Parameter2Connected then
      tmpPara^ := (Parameter2.pCH)$UDINT;
      no += 1;
    end_if;
  
  else
    TRACE_ERR("AlarmBufferBase::RegisterAlarmXPara(): unkown alarm object detected");
  end_if;


  // call base class to login alarm
  //---------------------------------------------------------------------
  retcode := _AlarmXBuffer::RegisterAlarmXPara( pThis   := pThis, 
                                                config  := config, 
                                                group   := group, 
                                                no      := no, 
                                                paras   := paras);
                                    
END_FUNCTION


FUNCTION VIRTUAL GLOBAL AlarmBufferBase::actOPMode::NewInst
	VAR_INPUT
		pPara 	: ^CmdStruct;
		pResult 	: ^Results;
	END_VAR
	VAR_OUTPUT
		ret_code 	: IprStates;
	END_VAR

  // check input parameter
  if pPara = NIL | pResult = NIL then
    ret_code := ERROR;
    return;
  end_if;

  //*****************************************************************************
  //** CHECK TYPE OF COMMAND                                                   **
  //*****************************************************************************
  
  case pPara^.uiCmd$t_e_AlarmCmd of
  
    // Methode for active OPMode
    //***************************************************************************
    Cmd_OPModeActive:
    
      // set length of result
      pResult^.uiLng := sizeof(t_e_OPMode);
      
      // call methode for active OPMode
      pResult^.aData[0]$t_e_OPMode := OPModeActive(eActOPMode := pPara^.aPara[0]$t_e_OPMode);
      
      ret_code := READY;

    // Methode for changing OPMode
    //***************************************************************************
    Cmd_OPModeChange:
    
      // set length of result
      pResult^.uiLng := sizeof(BOOL);
      
      // call methode for changing OPMode
      pResult^.aData[0] := OPModeChange(eActOPMode  := pPara^.aPara[0]$t_e_OPMode, 
                                        eNewOPMode  := pPara^.aPara[1]$t_e_OPMode);
     
      ret_code := READY;

    // new OPMode aktive
    //**************************************************************************
    Cmd_ActOPMode:
    
      actOPMode := pPara^.aPara[0]$t_e_OPMode;
      ret_code := READY;
      
     // unknown command
     //***************************************************************************
     else
      TRACE_ERR("AlarmBufferBase::actOPMode::NewInst(): unknown command");
      ret_code := ERROR;
      
  end_case;

END_FUNCTION


FUNCTION VIRTUAL AlarmBufferBase::OPModeChange
	VAR_INPUT
		eActOPMode 	: t_e_OPMode;
		eNewOPMode 	: t_e_OPMode;
	END_VAR
	VAR_OUTPUT
		bOK 	: BOOL;
	END_VAR
  
  // init returncode
  bOK := true;
  
  // get alarms from other stations
  AlarmStations();
  
  //*****************************************************************************
  //** DEPENDING ON THE NEW OPMODE DIFFERENT ALARMS GET CHECKED                **
  //*****************************************************************************
  
  case eNewOPMode of

    //***************************************************************************
    
    OPMode_Init:
      // nothing happens because of an alarm
      
    //***************************************************************************

    OPMode_Homing:
      
      // if at least one alarm is active => change to OPMode_Error
      if sOPModeAlarm.udOPModeHoming | 
         sOPModeStations.udOPModeHoming then
        bOK := false;
      end_if;

    //***************************************************************************

    OPMode_Manual:

      // if at least one alarm is active => change to OPMode_Error
      if sOPModeAlarm.udOPModeManual | 
         sOPModeStations.udOPModeManual then
        bOK := false;
      end_if;

    //***************************************************************************

    OPMode_SemiAuto:

      // if at least one alarm is active => change to OPMode_Error
      if sOPModeAlarm.udOPModeManual | sOPModeAlarm.udOPModeSemiAuto | 
         sOPModeStations.udOPModeManual | sOPModeStations.udOPModeSemiAuto then
        bOK := false;
      end_if;

    //***************************************************************************

    OPMode_Automatic:

      // if at least one alarm is active => change to OPMode_Error
      if sOPModeAlarm.udOPModeManual | sOPModeAlarm.udOPModeSemiAuto | sOPModeAlarm.udOPModeAutomatic | 
         sOPModeStations.udOPModeManual | sOPModeStations.udOPModeSemiAuto | sOPModeStations.udOPModeAutomatic  then
        bOK := false;
      end_if;

    //***************************************************************************

    OPMode_Error:
    
    //***************************************************************************
    
    else
      TRACE_ERR("AlarmBufferBase::OPModeChange(): not supported OPMode");
  
  end_case;

END_FUNCTION


FUNCTION VIRTUAL AlarmBufferBase::OPModeActive
	VAR_INPUT
		eActOPMode 	: t_e_OPMode;
	END_VAR
	VAR_OUTPUT
		eNewOPMode 	: t_e_OPMode;
	END_VAR

  // init returncode
  eNewOPMode := eActOPMode;

  // get alarms from other stations
  AlarmStations();

  //*****************************************************************************
  //** DEPENDING ON THE OPMODE DIFFERENT ALARMS GET CHECKED                    **
  //*****************************************************************************
  
  case eActOPMode of

    //***************************************************************************
    
    OPMode_Init:
      // nothing happens because of an alarm
      
    //***************************************************************************

    OPMode_Homing:
      
      // if at least one alarm is active => change to OPMode_Error
      if sOPModeAlarm.udOPModeHoming | 
         sOPModeStations.udOPModeHoming then
        eNewOPMode := OPMode_Error;
      end_if;

    //***************************************************************************

    OPMode_Manual:

      // if at least one alarm is active => change to OPMode_Error
      if sOPModeAlarm.udOPModeManual |
         sOPModeStations.udOPModeManual then
        eNewOPMode := OPMode_Error;
      end_if;

    //***************************************************************************

    OPMode_SemiAuto:

      // if at least one alarm for OPMode_Manual is active => change to OPMode_Error
      if sOPModeAlarm.udOPModeManual | 
         sOPModeStations.udOPModeManual then
        eNewOPMode := OPMode_Error;
        
      // if at least one alarm for OPMode_SemiAuto is active => change to OPMode_Manual
      elsif sOPModeAlarm.udOPModeSemiAuto | 
            sOPModeStations.udOPModeSemiAuto then
        eNewOPMode := OPMode_Manual;
      end_if;

    //***************************************************************************

    OPMode_Automatic:

      // if at least one alarm for OPMode_Manual is active => change to OPMode_Error
      if sOPModeAlarm.udOPModeManual |
         sOPModeStations.udOPModeManual then
        eNewOPMode := OPMode_Error;
      // if at least one alarm for OPMode_SemiAuto is active => change to OPMode_Manual
      elsif sOPModeAlarm.udOPModeSemiAuto |
            sOPModeStations.udOPModeSemiAuto then
        eNewOPMode := OPMode_Manual;
      // if at least one alarm for OPMode_Automatic is active => change to OPMode_SemiAuto
      elsif sOPModeAlarm.udOPModeAutomatic |
            sOPModeStations.udOPModeAutomatic then
        eNewOPMode := OPMode_SemiAuto;
      end_if;

    //***************************************************************************

    OPMode_Error:
    
    //***************************************************************************
    
    else
      TRACE_ERR("AlarmBufferBase::OPModeActive(): not supported OPMode");
      
  end_case;

END_FUNCTION

FUNCTION GLOBAL AlarmBufferBase::LoginAlarmClient
	VAR_INPUT
		pThis 	: ^AlarmStation;
	END_VAR
	VAR_OUTPUT
		bSuccessful 	: BOOL;
	END_VAR

  // check input-parameter
  if pThis = NIL then
    bSuccessful := false;
    return;
    
  // check limits of array
  elsif udAlarmClients >= sizeof(sAlarmStations) / sizeof(sAlarmStations[0]) then
    bSuccessful := false;
    return;
    
  end_if;
  
  // save pointer
  sAlarmStations[udAlarmClients].pThis := pThis;
  udAlarmClients += 1;

  // set returncode
  bSuccessful := true;
  
END_FUNCTION


FUNCTION AlarmBufferBase::AlarmStations
  VAR
    tmpCounter  : UDINT;
    tmpObject   : ^AlarmStation;
  END_VAR

  // check if stations are available
  if udAlarmClients then
  
    bdAlarmInfoStations := 0;
    _memset(#sOPModeStations, 0, sizeof(sOPModeStations));
    
    // loop to get alarminformation from all connected client
    for tmpCounter := 0 to udAlarmClients - 1 do
      
      // get pointer to object
      tmpObject := sAlarmStations[tmpCounter].pThis;
      
      // check if pointer is valid
      if tmpObject <> NIL then
        
        // call methode to fetch information
        if tmpObject^.GetAlarms(pAlarms     := #sAlarmStations[tmpCounter].sAlarmList,
                                pAlarmInfo  := (#sAlarmStations[tmpCounter].bdAlarmInfo)$^BDINT) = true then
        
          // calculate sum of all clients
          sOPModeStations.udOPModeInit       += sAlarmStations[tmpCounter].sAlarmList.udOPModeInit;
          sOPModeStations.udOPModeHoming     += sAlarmStations[tmpCounter].sAlarmList.udOPModeHoming;
          sOPModeStations.udOPModeStop       += sAlarmStations[tmpCounter].sAlarmList.udOPModeStop;
          sOPModeStations.udOPModeSetup      += sAlarmStations[tmpCounter].sAlarmList.udOPModeSetup;
          sOPModeStations.udOPModeManual     += sAlarmStations[tmpCounter].sAlarmList.udOPModeManual;
          sOPModeStations.udOPModeSemiAuto   += sAlarmStations[tmpCounter].sAlarmList.udOPModeSemiAuto;
          sOPModeStations.udOPModeAutomatic  += sAlarmStations[tmpCounter].sAlarmList.udOPModeAutomatic;
          sOPModeStations.udOPModeError      += sAlarmStations[tmpCounter].sAlarmList.udOPModeError;
        
          // alarminfo from all clients
          bdAlarmInfoStations := bdAlarmInfoStations OR sAlarmStations[tmpCounter].bdAlarmInfo;
          
        else
          TRACE_ERR("AlarmBufferBase::CheckClient(): failed to fetch alarminformation from client");
        end_if;

      end_if;

    end_for;
  
  end_if;

END_FUNCTION


