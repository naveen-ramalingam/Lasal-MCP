FUNCTION VIRTUAL GLOBAL AlarmBufferBase::ActionAlarmIntern
	VAR_INPUT
		pThis 	: UDINT;
		config 	: UDINT;
		group 	: UDINT;
		state 	: DINT;
		parano 	: UDINT;
		ppara 	: ^DINT;
	END_VAR
  VAR
  	tmpPara       : ^DINT;
    tmpValue      : SINT;
    tmpInfo       : BDINT;
    tmpMask       : BDINT;
    tmpAlarmInfo  : BDINT;
    tmpCounter    : USINT;
    tmpOPMode     : t_e_OPMode;
  END_VAR

  // check if additional parameters are available
  if parano >= 2 then

    // get parameters of alarm
    tmpOPMode := ((ppara + (parano - 2) * sizeof(DINT))^)$t_e_OPMode;
    tmpInfo   := ((ppara + (parano - 1) * sizeof(DINT))^)$BDINT;
    
    // count alarm for each OPMode
    //---------------------------------------------------------------------
    // alarm active
    if state > 0 then // HubChr v1.4 changed from "state = TRUE"
      tmpValue := 1;
    // alarm inacitve
    elsif state = false then
      tmpValue := -1;
    else
      tmpValue := 0;
    end_if;

    case tmpOPMode of
    
      OPMode_Init:
        sOPModeAlarm.udOPModeInit$DINT       += tmpValue;
        
      OPMode_Homing:    
        sOPModeAlarm.udOPModeHoming$DINT     += tmpValue;
        
      OPMode_Stop:      
        sOPModeAlarm.udOPModeStop$DINT       += tmpValue;
        
      OPMode_Setup:     
        sOPModeAlarm.udOPModeSetup$DINT      += tmpValue;
        
      OPMode_Manual:    
        sOPModeAlarm.udOPModeManual$DINT     += tmpValue;
        
      OPMode_SemiAuto:  
        sOPModeAlarm.udOPModeSemiAuto$DINT   += tmpValue;
        
      OPMode_Automatic: 
        sOPModeAlarm.udOPModeAutomatic$DINT  += tmpValue;
        
      OPMode_Error:     
        sOPModeAlarm.udOPModeError$DINT      += tmpValue;
        
    else
      TRACE_ERR("AlarmBufferBase::ActionAlarm(): unkown operationmode detected");
    end_case;
    
    // check alarminfo
    //---------------------------------------------------------------------
    
    // reset alarminfo
    tmpAlarmInfo := 0;
    
    // evaluate each bit
    for tmpCounter := 0 to 31 do
    
      // build mask
      tmpMask := 2#1 SHL tmpCounter;
      
//v1.9 BruSte: Error Correction - with this Code some old AlarmInfos could be lost!
//      // check if bit is set
//      if tmpInfo AND tmpMask then
//        
//        sAlarmInfo[tmpCounter]$DINT += tmpValue;
//        
//        if sAlarmInfo[tmpCounter] then
//          tmpAlarmInfo := tmpAlarmInfo OR tmpMask;
//        end_if;
//
//      end_if;

//v1.9 BurSte: properly working old code from version v1.7

      // check if bit is set
      if tmpInfo AND tmpMask then
        sAlarmInfo[tmpCounter]$DINT += tmpValue;
      end_if;
      
      if sAlarmInfo[tmpCounter] then
        tmpAlarmInfo := tmpAlarmInfo OR tmpMask;
      end_if;
      
    end_for;

    // sum of all bits
    bdAlarmInfo := tmpAlarmInfo;
    
    // call user-methods
    //---------------------------------------------------------------------
    // alarm active
    if state > 0 then // HubChr v1.4 changed from "state = TRUE"
      AlarmActive(udNo    := config,
                  eOPMode := tmpOPMode, 
                  bdInfo  := tmpInfo);
    // alarm inacitve
    elsif state = false then
      AlarmInactive(udNo    := config,
                    eOPMode := tmpOPMode, 
                    bdInfo  := tmpInfo);
    elsif state <> -1 then
      TRACE_ERR("AlarmBufferBase::ActionAlarm(): unknown alarm state detected");
    end_if;

    // add Parameter 1 + Parameter 2
    //---------------------------------------------------------------------
    // get pointer behind the alarmparameter
    // the two parameter at the beginning are OPMode + AlarmInfo
    tmpPara := ppara + (parano - 2) * sizeof(DINT);
    
    // add parameter to alarm
    if bsConfig.Parameter1Connected then
      Parameter1  := Parameter1.Read();
      tmpPara^    := Parameter1;
      tmpPara     += sizeof(DINT);
    else
      parano -= 1;
    end_if;
    
    // add parameter to alarm
    if bsConfig.Parameter2Connected then
      Parameter2  := Parameter2.Read();
      tmpPara^    := Parameter2;
    else
      parano -= 1;
    end_if;
 
  elsif state <> -1 then
    TRACE_ERR("AlarmBufferBase::ActionAlarm(): unkown alarm object detected");
  end_if;
  
  // alarm quit
  if state = -1 then
    AlarmQuit(udNo    := config);
  end_if;

  // save alarm in AlarmBufferBase
  //---------------------------------------------------------------------
  _AlarmXBuffer::ActionAlarmIntern(pThis, config, group, state, parano, ppara);

END_FUNCTION
