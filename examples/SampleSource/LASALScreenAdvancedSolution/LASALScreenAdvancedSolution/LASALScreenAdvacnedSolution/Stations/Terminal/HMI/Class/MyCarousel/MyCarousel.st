FUNCTION MyCarousel::PlaceCarousel
	VAR_INPUT
		pPic 	: ^void;
		pLasalObjName 	: ^CHAR;
		pLSEObjName 	: ^CHAR;
		Room 	: _ROOM;
		CaroItemsCount 	: UDINT;
		VarNoPos 	: UDINT;
	END_VAR
	VAR_OUTPUT
		Retcode 	: DINT;
	END_VAR
  VAR
    index         : UDINT;
    caroItem      : UDINT;
    objectName    : ARRAY[0..255]of CHAR;
    objectNumber  : ARRAY[0..255]of CHAR;   
    objectNo      : UDINT;
    lasalObjectNo : UDINT;
    varinfo       : _VARINFO;
    retGetVarInfo : BOOL;
  END_VAR
  
  Retcode := 0;
  
  // check for valid pointers
  if ((pPic = NIL) | (pLasalObjName = NIL) | (pLSEObjName = NIL)) then
    Retcode := -1; // invalid pointers
    return;
  end_if;
  
  objectNo := get_no_by_label(p0:= pLSEObjName, 
                              x1:= OBJLST, 
                              x2:= 0);
                             
  if (objectNo = DEFSCOPE) then
    Retcode := -2; // invalid LSE objectname
    return;
  end_if;
  
  if (CaroItemsCount > MAX_ITEMS) then
    Retcode := -3; // to much items
    return;
  end_if;
  
  noOfCarouselItems := 0;
  caroItem := 1;
  
  for index := 1 to (CaroItemsCount) do
    
    pError := SigCLib.StrCpy(dst0:= #objectName[0], 
                             src0:= pLasalObjName);
                   
    if (pError <> #objectName[0]) then 
      Retcode := -4;
      return;
    end_if;
                     
    objectNumber[0] := 0;
    
    pError := SigCLib.IToA(val:= to_dint(index), 
                           dst:= #objectNumber[0], 
                           base:= 10);
                 
    if (pError <> #objectNumber[0]) then 
      Retcode := -5;
      return;
    end_if;
    
    pError := SigCLib.StrCat(ps1:= #objectName[0], 
                             ps2:= #objectNumber[0]);
                   
    if (pError <> #objectName[0]) then 
      Retcode := -6;
      return;
    end_if;
                     
    lasalObjectNo := VarList_GetVarNoStation(p0:= #objectName[0], 
                                             station:= 255);
                                            
    if (lasalObjectNo = DEFSCOPE) then
      Retcode := -7; // invalid objectname / no
      return;
    end_if;

    retGetVarInfo := VarList_GetVarInfo(p0:= #varinfo, 
                                        x1:= lasalObjectNo);
                                        
    if (retGetVarInfo = FALSE) then
      Retcode := -8; // no var info found
      return;
    end_if;
    
    if (varinfo.lasalid.id = 0) then
      Retcode := -9; // wrong lasal ID
      return;
    end_if;
    
    if (ShowActive = 1) then
                
      if (varinfo.lasalid.id$^MyValues^.Active.Read()) then
      
        Retcode := AddItem(ObjNo:= objectNo, 
                           LasalObjNo:= lasalObjectNo,
                           CarItemNo:= caroItem);
        
        caroItem += 1;             
        noOfCarouselItems += 1;

      end_if;  
      
    else
      Retcode := AddItem(ObjNo:= objectNo, 
                         LasalObjNo:= lasalObjectNo,
                         CarItemNo:= caroItem);
                          
      caroItem += 1;             
      noOfCarouselItems += 1;
        
    end_if;
   
  end_for;
 
  for index := caroItem to (CaroItemsCount) do
    myCaroItems[index].ObjNo := 0;
    init_VARLABEL(p0:= #myCaroItems[index].loader);
  end_for;

  carousel := add_carousel(mp:= pPic$^_MY_PICTURE, 
                           room:= #Room, 
                           cino:= to_uint(noOfCarouselItems), 
                           ci:= #myCaroItems[1], 
                           varno_pos:= DEFSCOPE, 
                           horizontal:= HORIZONTAL_DRAW_ORDER_CARO, 
                           infinite:= INFINITE_CARO, 
                           _dx:= ELEMENT_GAP_CARO);

  #pragma warning(disable:69);
  if (VERTICAL_SCROLL_BAR) then
  #pragma warning(default:69);

    add_carousel_scrollbar(mp:= pPic$^_MY_PICTURE, 
                           cno:= carousel, 
                           frame:= FRAMEWORK_NEW_AGE_DARK, 
                           col_back:= LSE_COLOR252, 
                           col_front:= LSE_color246,
                           col_symbol:= LSE_COLOR255,
                           col_topleft:= INVISIBLE, 
                           col_bottomright:= INVISIBLE);
  end_if;

  Retcode := 1;
  
END_FUNCTION


FUNCTION MyCarousel::AddItem
	VAR_INPUT
		ObjNo 	: UDINT;
		LasalObjNo 	: UDINT;
		CarItemNo 	: UDINT;
	END_VAR
	VAR_OUTPUT
		Retcode 	: DINT;
	END_VAR
  VAR
  	result : _RESULT;
    variable : _VARIABLE;
  END_VAR
  
  Retcode := 0;
                           
  myCaroItems[CarItemNo].ObjNo := TO_UINT(ObjNo);
  
  #pragma warning(disable:74);
  myCaroItems[CarItemNo].loader.no := 1;
  myCaroItems[CarItemNo].loader.info[0].state := VAR_VAL;
  myCaroItems[CarItemNo].loader.info[0].value := TO_DINT(LasalObjNo);
  #pragma warning(default:74);

  
  
  if (VarList_GetSystemData(p0:= #result, 
                            p1:= #variable, 
                            p2:= #myCaroItems[CarItemNo].loader, 
                            x3:= true) = TRUE) then
    Retcode := -7;
    return;
  end_if;  
  
END_FUNCTION


