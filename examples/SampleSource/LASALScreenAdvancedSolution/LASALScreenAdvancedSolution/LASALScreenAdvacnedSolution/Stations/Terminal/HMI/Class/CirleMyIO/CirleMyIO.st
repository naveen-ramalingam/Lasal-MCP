  retcode := _IDLE;
  
  if pe^.ftype = _EVENT_HIDMOVE | pe^.ftype = _EVENT_HIDPRESS then
  
    if ((pe^.dot.x >= ped^.input.io.space.xy1.x + (CircleRadius/2))   &  
        (pe^.dot.x <= ped^.input.io.space.xy2.x - (CircleRadius/2)-1) &
