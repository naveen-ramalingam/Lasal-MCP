FUNCTION __CDECL VIRTUAL GLOBAL IconDestList::Line
	VAR_INPUT
		ps 	: ^_SCROLL;
		pr 	: ^_ROOM;
		line 	: UINT;
		state 	: BOOL;
	END_VAR
  VAR
    att       :_ATTRIB;
    schemeNo  : UDINT;
    lineNo    : ARRAY [0..10] of CHAR;
    pImage    : ^_BMP;
  END_VAR

  _memcpy(ptr1:= #myPioScroll, ptr2:= ps, cntr:= sizeof(_SCROLL));  

  if (line < Scroll.position.no) then   
  
   ps^.line_height := 75;
   
   att := T_SOLID or T_COPY or T_PROP or T_LEFTBOUND;
   
   schemeNo := get_no_by_label(p0:= "DragDrop", x1:= IMAGESCHEME, x2:= 0);

   if (schemeNo = DEFSCOPE) then
     TRACE("Image not found in ImageScheme 'DragDrop'");
     return;
   end_if;

   pImage$^void := NewDoScheme(x0:= IMAGESCHEME, 
                               x1:= Lines[line], 
                               x2:= schemeNo);
   
   if (pImage <> NIL) then
   
     myImageRoom.xy1.x := pr^.xy1.x;
     myImageRoom.xy1.y := pr^.xy1.y;
     myImageRoom.xy2.x := pr^.xy1.x + to_int(Scroll.line_height);
     myImageRoom.xy2.y := pr^.xy2.y;   
     
     out_zoom_BMP(p0:= #myImageRoom, 
                  p1:= pImage, 
                  x2:= att); 

     // insert line no
     myImageRoom.xy1.x := pr^.xy1.x + 76;
     myImageRoom.xy1.y := pr^.xy1.y;
     myImageRoom.xy2.x := pr^.xy1.x + 96;
     myImageRoom.xy2.y := pr^.xy2.y;   
     
     _memset(dest:= #lineNo[0], 
             usByte:= 0, 
             cntr:= sizeof(lineNo));
     
     SigCLib.IToA(val:= line, 
                  dst:= #lineNo[0], 
                  base:= 10);
     
     if (pLSEpio = NIL) then
       return;
     end_if;
     
     OutTextAlign(p0:= #lineNo[0], 
                  x1:= 0, 
                  p1:= #myImageRoom, 
                  x2:= pLSEpio^.font, 
                  x3:= pLSEpio^.attrib, 
                  x9:= pLSEpio^.frametype, 
                  x4:= TextColor, 
                  x5:= FrameColor, 
                  x6:= BackgroundColor, 
                  x7:= 1);
   else
     TRACE("Image not found in ImageScheme 'DragDrop'");
   end_if;

  end_if;

END_FUNCTION


