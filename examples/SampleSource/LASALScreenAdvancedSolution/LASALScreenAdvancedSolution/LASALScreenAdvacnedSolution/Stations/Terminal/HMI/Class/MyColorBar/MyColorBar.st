                 x1:= 0,               
                 p1:= #pio^.space,     
                 x2:= pio^.font,       
                 x3:= pio^.attrib,     
                 x9:= pio^.frametype, 
                 x4:= pio^.coltxt,
                 x5:= _Grafix.MakeColor(backcolor:=INVISIBLE, frontcolor:=INVISIBLE), 
                 x6:= _Grafix.MakeColor(backcolor:=INVISIBLE, frontcolor:=INVISIBLE), 
                 x7:= sizeof(_ASCII)); 
  end_if;

  // visible screen switched on
  pop_screen(p0:= #act); 
  
  // copy image on visible screen
  copy_screen(p0:= #act, p1:= #pio^.space);

  retcode := _IDIDIT;

END_FUNCTION
