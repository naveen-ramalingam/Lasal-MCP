               y0:= pio^.space.xy1.y, 
               x1:= pio^.space.xy2.x, 
               y1:= pio^.space.xy2.y, 
               attrib:= pio^.attrib, 
               color:= pio^.colback);
                 
  // draw lower space with actual value
  if (ActPixel <= LowerSpaceHeight) then
  
    color_course(p0:= #LowerSpace, 
                 x1:= to_int(ActPixel) * -1, 
                 x2:= MinColor, 
                 x3:= BarColor, 
                 x4:= T_COPY or T_SOLID or T_VERTBOUND);
                 
