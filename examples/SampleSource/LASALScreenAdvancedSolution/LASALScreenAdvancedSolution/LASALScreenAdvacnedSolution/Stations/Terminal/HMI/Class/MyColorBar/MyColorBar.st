  elsif (ActPixel >= UpperSpaceHeight) then
  
    _Grafix.Beam(x0:= MidSpace.xy1.x, 
                 y0:= MidSpace.xy1.y, 
                 x1:= MidSpace.xy2.x, 
                 y1:= MidSpace.xy2.y, 
                 attrib:= T_COPY or T_SOLID or T_VERTBOUND, 
                 color:= BarColor);
                   
    color_course(p0:= #UpperSpace, 
                 x1:= (to_int(ActPixel) - UpperSpaceHeight) * -1, 
                 x2:= BarColor, 
                 x3:= MaxColor, 
                 x4:= T_COPY or T_SOLID or T_VERTBOUND);
