  // set color depending on state
  if (state = TRUE) then
    color := _Grafix.MakeColor(backcolor:= INVISIBLE, 
                               frontcolor:= ps^.color_activ);
  else
    color := _Grafix.MakeColor(backcolor:= INVISIBLE, 
                               frontcolor:= ps^.color_inactiv);


  end_if;
  
  // query on linenumber
  if (line < Scroll.position.no) then
    //set attributes
    att := T_LEFTBOUND or T_UPBOUND or T_COPY or T_PROP or T_SOLID;

