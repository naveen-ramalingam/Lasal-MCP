    //draw string of third column
    _Grafix.OutTextXY(x0:= pr^.xy1.x + 400, 
                      y0:= pr^.xy1.y, 
                      textptr:= "Cat", 
                      attrib:= att, 
                      color:= color, 
                      chr_size:= sizeof(_ASCII));
    
    //draw column seperator
    _Grafix.Line(x0:= pr^.xy1.x + 190, 
                 y0:= pr^.xy1.y, 
                 x1:= pr^.xy1.x + 190, 
                 y1:= pr^.xy2.y, 
                 attrib:= att, 
