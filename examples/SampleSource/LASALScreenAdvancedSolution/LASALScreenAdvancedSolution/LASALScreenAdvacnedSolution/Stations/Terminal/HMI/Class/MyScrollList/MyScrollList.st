    _Grafix.OutTextXY(x0:= pr^.xy1.x + 10, 
                      y0:= pr^.xy1.y, 
                      textptr:= #txt[0], 
                      attrib:= att, 
                      color:= color, 
                      chr_size:= sizeof(_ASCII));
     
