    txt[10] := 0;
    
    //draw string of second column
    _Grafix.OutTextXY(x0:= pr^.xy1.x + 200, 
                      y0:= pr^.xy1.y, 
                      textptr:= #txt[0], 
                      attrib:= att, 
                      color:= color, 
                      chr_size:= sizeof(_ASCII));
    
    // column 3
