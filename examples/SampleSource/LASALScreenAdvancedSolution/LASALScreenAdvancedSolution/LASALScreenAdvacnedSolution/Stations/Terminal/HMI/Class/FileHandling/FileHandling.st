        intError := -1;
        Steps := tFH_Error;
        return;
        
      end_if;
      
      pError := SigCLib.StrCpy(dst0:= #FullFileName[0], 
                               src0:= #Temp[0]);
                                 
      if (pError <> #FullFileName[0]) then
        IntError := -2;
        Steps := tFH_Error;
        return;
      end_if;
        
      // ==========  get file name  ==========
      retCode := FileName.TxtGet(pdst:= #Temp[0],
                                        dstsize:= sizeof(Temp));
                                
      if (retCode = 0) then
        
        intError := -3;
        Steps := tFH_Error;
        return;
        
      end_if;
      
      pError := SigCLib.StrCat(ps1:= #FullFileName[0],
                               ps2:= #Temp[0]);
                                 
      if (pError <> #FullFileName[0]) then
        IntError := -4;
        Steps := tFH_Error;
        return;
      end_if;
      
      // ==========  get file extension  ==========
      retCode := FileExtension.TxtGet(pdst:= #Temp[0],
                                       dstsize:= sizeof(Temp));
                                
      if (retCode = 0) then
        
        intError := -5;
        Steps := tFH_Error;
        return;
        
      end_if;
      
