FUNCTION GLOBAL FileHandling::StartWrite
	VAR_INPUT
		pData 	: ^DINT;
		Amount 	: UDINT;
	END_VAR
	VAR_OUTPUT
		Retcode 	: DINT;
	END_VAR
  
  if (pData = NIL) then
    IntError := -14;    
    Retcode := -1;
    return;
  end_if;  
  
  if (FileIsCreated = 0) then
    Retcode := -2;
    return;
  end_if;

  pSaveData := pData;
  Length := Amount;
  ReadFile := FALSE;
  Steps := tFH_FileOpen;
  
END_FUNCTION


