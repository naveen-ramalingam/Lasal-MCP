FUNCTION VIRTUAL GLOBAL DataRecordSave::Init

  if _FirstScan then

    // set buffer to 4KB
    Buffer := AllocateSize;
    MaxBufferEntries := AllocateSize / sizeof(_DOT);

    // allocate memory
    pStart$^void := _StdLib.MallocV1(size0:= Buffer,
                                     mark0:= 0); 

    if (pStart = NIL) then
      IntError := -1;
      return;
    else
    
      pError := _StdLib.MemSet(dest:= pStart,
                               value:= 0,
                               size:= Buffer);
                               
      if (pError <> pStart) then 
        IntError := -2;
        return;
      end_if;
     
    end_if;

    Del := TRUE;
  end_if;

END_FUNCTION


FUNCTION __CDECL VIRTUAL GLOBAL DataRecordSave::GetEvent
	VAR_INPUT
		ped 	: ^_EDITOR;
		pe 	: ^_EVENT;
	END_VAR
	VAR_OUTPUT
		retcode (EAX) 	: _DOIT;
	END_VAR
  
  _MyIO::GetEvent(ped:=ped, pe:=pe);
  
  retcode := _IDLE;
  
  // event hidmove
  if pe^.ftype = _EVENT_HIDMOVE then

    if ((pe^.dot.x > ped^.input.io.space.xy1.x) &
        (pe^.dot.x < ped^.input.io.space.xy2.x) &
        (pe^.dot.y > ped^.input.io.space.xy1.y) &
        (pe^.dot.y < ped^.input.io.space.xy2.y)) then
        
        Del := FALSE;
        
        retcode := _IDIDIT;
        
        // actual coordinates in area
        xKoord := pe^.dot.x - ped^.input.io.space.xy1.x;
        yKoord := pe^.dot.y - ped^.input.io.space.xy1.y;
       
        // overflow
        if (BufferCounter >= MaxBufferEntries) then
          BufferCounter := 0;
          
          pAct := pStart;
        end_if;
                
        pAct^.x := pe^.dot.x;
        pAct^.y := pe^.dot.y;

        pAct := pAct + sizeof(_DOT);
        BufferCounter += 1;
         
     end_if;
     
  // event hidrelease   
  elsif (pe^.ftype = _EVENT_HIDRELEASE) then
    Del := TRUE;
  end_if;

END_FUNCTION


FUNCTION __CDECL VIRTUAL GLOBAL DataRecordSave::Draw
	VAR_INPUT
		pio 	: ^_IO;
		pr 	: ^_RESULT;
		pv 	: ^_VARIABLE;
		input 	: BOOL;
	END_VAR
	VAR_OUTPUT
		retcode (EAX) 	: _DOIT;
	END_VAR
  VAR
  	act : _NEWSCREEN;
  END_VAR
  
  _MyIO::Draw(pio:=pio, pr:=pr, pv:=pv, input:=input);
  
  push_screen(p0:=#act);

  RecordColor := _Grafix.MakeColor(backcolor:= pio^.coltxt,
                                   frontcolor:= pio^.coltxt);
                                     
  bgColor := _Grafix.MakeColor(backcolor:= pio^.colback,
                               frontcolor:= pio^.colback);
  
  // draw background
  if (Del = TRUE) then
    
      _Grafix.Beam(x0:= pio^.space.xy1.x,
                   y0:= pio^.space.xy1.y,
                   x1:= pio^.space.xy2.x,
                   y1:= pio^.space.xy2.y,
                   attrib:= pio^.attrib,
                   color:= bgColor);                     
  end_if;
  
  // place read data on screen
  if FileIsRead = TRUE then
  
    pStart$^Dint := FileRead.ReadKoords();
    pData := pstart;
    pNext := pData + sizeof(_DOT);
       
    
    while ((pData$^Dint <= pStart$^Dint + Buffer) & (FileIsRead = TRUE)) do
    
      if ((pNext^.x = 0) & (pNext^.y = 0)) then
        pNext := pData;
        FileRead.SetReadState(IsDrawing:=FALSE);
      end_if;
    
      _Grafix.Line(x0:= pData^.x,
                   y0:= pData^.y,
                   x1:= pNext^.x,
                   y1:= pNext^.y,
                   attrib:= pio^.attrib,
                   color:= RecordColor);
      
      pData += sizeof(_DOT);
      pNext += sizeof(_dot);
            
      if (pNext >= pStart + Buffer) then
        pNext := pData;
      end_if;
      
    end_while;

    FileRead.SetReadState(IsDrawing:= FALSE);
    
  // draw data on screen
  else
 
    if (pAct <> NIL) then
      pCheck := pStart;
      
      while (pCheck < (pAct - sizeof(_DOT))) do
    
        pNext := pCheck + sizeof(_DOT);
        
        _Grafix.Line(x0:= pCheck^.x,
                     y0:= pCheck^.y,
                     x1:= pNext^.x,
                     y1:= pNext^.y,
                     attrib:= pio^.attrib,
                     color:= RecordColor);
                       
        pCheck += sizeof(_DOT);

      end_while;

    end_if;
  end_if;
  
  pop_screen(p0:=#act);
  copy_screen(p0:=#act, p1:=#pio^.space);
  
  retcode := _IDIDIT;

END_FUNCTION

