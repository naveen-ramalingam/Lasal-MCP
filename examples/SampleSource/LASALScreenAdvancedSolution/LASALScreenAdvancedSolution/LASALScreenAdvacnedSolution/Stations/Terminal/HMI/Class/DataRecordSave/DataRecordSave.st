FUNCTION __CDECL VIRTUAL GLOBAL DataRecordSave::IF_Run
	VAR_INPUT
		pio 	: ^_IO;
		input 	: BOOL;
	END_VAR
  
  _MyIO::IF_Run(pio:=pio, input:=input);
  
  
  //****************************************************************
  // save data
  //****************************************************************
  if (Save = 1) then
    Save := 0;
    Retcode := FileHandling.StartWrite(pData:= pStart$^DINT,
                                       Amount:= Buffer);
    
    if (Retcode < 0) then
      IntError := -2;
      return;
    end_if;

     Refresh := 1;   
  end_if;
   
  //*************************************************************** 
  // load data
  //***************************************************************
  if (Load = 1) then
    FileRead.StartRead := 1;
    Load := 0;

    if (Retcode < 0) then
      IntError := -3;
      return;
    end_if;

     Refresh := 1;   
  end_if;  
  
  FileIsRead := FileRead.GetReadState();
  
  if (FileIsRead = TRUE) then
    Refresh := 1;
  end_if;
  
  //***************************************************************
  // clear data
  //***************************************************************
  if (Clear = 1) then
  
    Retcode := ClearScreen();
    
    if (Retcode < 0) then
      IntError := -4;
      return;
    end_if;   
   
  end_if;

END_FUNCTION


FUNCTION GLOBAL DataRecordSave::ClearScreen
	VAR_OUTPUT
		Retcode 	: DINT;
	END_VAR
  
  Retcode := 0;
  
  // clear screen
  if ((_StdLib.MemSet(dest:=pStart,
                      value:=0,
                      size:=Buffer)) <> pStart) then
    Retcode := -1;
    return;
  end_if;  
  
  Refresh:= 1;

END_FUNCTION


