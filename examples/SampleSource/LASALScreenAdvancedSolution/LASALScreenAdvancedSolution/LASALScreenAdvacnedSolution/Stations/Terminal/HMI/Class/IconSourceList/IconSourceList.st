FUNCTION VIRTUAL GLOBAL IconSourceList::Init
   
  if (_FirstScan = TRUE) then
  
    Scroll.position.no := 10; // nummber of lines
    Scroll.line_height := 75; // height of the line
    
    // colors for text, frame and background
    TextColor       := _Grafix.MakeColor(backcolor:= INVISIBLE, 
                                         frontcolor:= BLACK);
                                         
    FrameColor      := _Grafix.MakeColor(backcolor:= INVISIBLE, 
                                         frontcolor:= INVISIBLE);
                                         
    BackgroundColor := _Grafix.MakeColor(backcolor:= INVISIBLE, 
                                         frontcolor:= INVISIBLE);
  end_if;                     
  
END_FUNCTION 


FUNCTION __CDECL VIRTUAL GLOBAL IconSourceList::Line
  VAR_INPUT
		ps 	: ^_SCROLL;
		pr 	: ^_ROOM;
		line 	: UINT;
		state 	: BOOL;
	END_VAR  
  VAR
  	att         :_ATTRIB;
    myImageRoom : _ROOM;
    lineNo      : ARRAY [0..10] of CHAR;
    pImage      : ^_BMP;
  END_VAR

  if (pLSEpio = NIL) then
    TRACE("pio was not assigned to pLSEpio.");
    return;
  end_if;
  
  if (line < Scroll.position.no) then
    
    _memcpy(ptr1:= #myRoom, ptr2:= ps, cntr:= sizeof(_ROOM));
    
    // number of the applied scheme
    SchemeNo := get_no_by_label(p0:= "DragDrop", 
                                x1:= IMAGESCHEME, x2:=0);
                                
    if (SchemeNo = DEFSCOPE) then
      TRACE("Image not found in ImageScheme 'DragDrop'");
      return;
    end_if;
    
    pImage$^void := NewDoScheme(x0:= IMAGESCHEME, 
                                x1:= line, 
                                x2:= SchemeNo);
                               
    if (pImage <> NIL) then
    
      myImageRoom.xy1.x := pr^.xy1.x;
      myImageRoom.xy1.y := pr^.xy1.y;
      myImageRoom.xy2.x := pr^.xy1.x + to_int(Scroll.line_height);
      myImageRoom.xy2.y := pr^.xy2.y;   
    
      att := T_SOLID or T_COPY or T_PROP or T_LEFTBOUND;
      
      out_zoom_BMP(p0:= #myImageRoom, 
                   p1:= pImage, 
                   x2:= att); 
      
      // insert the line no
      myImageRoom.xy1.x := pr^.xy1.x + 76;
      myImageRoom.xy1.y := pr^.xy1.y;
      myImageRoom.xy2.x := pr^.xy1.x + 76 + 20;
      myImageRoom.xy2.y := pr^.xy2.y;   
      
      _memset(dest:= #lineNo[0], usByte:= 0, cntr:= sizeof(lineNo));
      
      SigCLib.IToA(val:= line, dst:= #lineNo[0], base:= 10);
      
   
      OutTextAlign(p0:= #lineNo[0], 
                   x1:= 0, 
                   p1:= #myImageRoom, 
                   x2:= pLSEpio^.font, 
                   x3:= pLSEpio^.attrib, 
                   x9:= pLSEpio^.frametype, 
                   x4:= TextColor, 
                   x5:= FrameColor, 
                   x6:= BackgroundColor, 
                   x7:= 1);
    else
      TRACE("Image not found in ImageScheme 'DragDrop'");
      return;
    end_if;

  end_if;

END_FUNCTION


FUNCTION __CDECL VIRTUAL GLOBAL IconSourceList::GetEvent
	VAR_INPUT
		ped 	: ^_EDITOR;
		pe 	: ^_EVENT;
	END_VAR
	VAR_OUTPUT
		retcode (EAX) 	: _DOIT;
	END_VAR
  
  pDragDropPio := DragDropArea.GetDimension();
  pDestListScroll := DestList.GetDimensionDestScroll();

  case pe^.ftype of
    //===========================================================================
    _EVENT_HIDPRESS:
      
      // IconSourceList icons-area
      if ((pe^.dot.x >= myRoom.xy1.x) &
          (pe^.dot.x <= myRoom.xy2.x - LEVELBUTTON_WIDTH) &
          (pe^.dot.y >= myRoom.xy1.y) & 
          (pe^.dot.y <= myRoom.xy2.y)) then      

        SelectedLineNo := (((pe^.dot.y - ped^.input.io.room.xy1.y) 
                            / Scroll.line_height) + Scroll.position.begin);
                            
        DragDropArea.SetLineNo(SelectedLine:= SelectedLineNo);
        // selected icon
        DragDropArea.SetIcon(SelectedLine:= SelectedLineNo);
        IconSelected := TRUE;         
      
      // IconSourceList Scroll-Area
      elsif ((pe^.dot.x >= myRoom.xy2.x - LEVELBUTTON_WIDTH) &
             (pe^.dot.x <= myRoom.xy2.x) &
             (pe^.dot.y >= myRoom.xy1.y) & 
             (pe^.dot.y <= myRoom.xy2.y)) then  
        
        // stop drawing 
        DragDropArea.DeleteIcon();  
        IconSelected := FALSE;
        
        Refresh := 1;                  
        retcode := _IDIDIT;               
      end_if;
    
    //===========================================================================
    _EVENT_HIDMOVE:
      
      _memcpy(ptr1:= #lastEvent, 
              ptr2:= pe, 
              cntr:= sizeof(lastEvent));
              
      // draw icon
      if (IconSelected = TRUE) then
      
        DragDropArea.DrawIcon(CoordX:= pe^.dot.x, 
                              CoordY:= pe^.dot.y);      
      end_if;
    
    //===========================================================================
    _EVENT_HIDRELEASE:
      // IconDestList icon-area
      if ((lastEvent.dot.x >= pDestListScroll^.out_room.xy1.x) &
          (lastEvent.dot.x <= pDestListScroll^.out_room.xy2.x - LEVELBUTTON_WIDTH) &
          (lastEvent.dot.y >= pDestListScroll^.out_room.xy1.y) & 
          (lastEvent.dot.y <= pDestListScroll^.out_room.xy2.y)) then 
         
         DestList.InsertIcon(IconNo:= SelectedLineNo, 
                             pEvent:= #lastEvent);
      end_if;

      // stop drawing
      DragDropArea.ClearScreen();        
      DragDropArea.DeleteIcon();  
      IconSelected := FALSE;
      
      Refresh := 1;       
      retcode := _IDIDIT;                    
      
  end_case;

  // call base class
  retcode := _ScrollArea2::GetEvent(ped:= ped, pe:= pe);  

END_FUNCTION


