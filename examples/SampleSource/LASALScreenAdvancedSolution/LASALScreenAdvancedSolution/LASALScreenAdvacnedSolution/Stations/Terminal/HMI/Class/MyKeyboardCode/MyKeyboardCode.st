FUNCTION VIRTUAL GLOBAL MyKeyboardCode::IF_WindowRun
	VAR_INPUT
		whoami 	: ^_WHOAMI;
		pic 	: ^void;
		event 	: ^_EVENT;
	END_VAR
  
  if ((whoami^.ima = IMA_PICTURE) | (whoami^.ima = IMA_WINDOW)) then
  
    if (event^.ftype = _EVENT_KEYPRESS) then
    
      KeyCode := event^.scancode;
      
      //=====================================================
      case KeyCode of
        //---------------------------------------------------
        _F1:  // button F1 to open Screen 1
          InsertCmd(x0:= CMD_NEWPICTURE, x1:= 1, x2:= 0);
        
        //---------------------------------------------------
        _F2: // button F2 to open Screen 2
          InsertCmd(x0:= CMD_NEWPICTURE, x1:= 2, x2:= 0);
        
        //---------------------------------------------------
        _F3: // button F3
          InsertCmd(x0:= CMD_NEWPICTURE, x1:= 3, x2:= 0);
        
        //---------------------------------------------------
        _HOME: // left windows button
          InsertCmd(x0:= CMD_NEWPICTURE, x1:= 0, x2:= 0);
        
        //---------------------------------------------------
        _ESC: // button ESC
          InsertCmd(x0:= CMD_RETURN, x1:= 0, x2:= 0);
          
      end_case;
      //=====================================================
      
    end_if;
    
  end_if;

END_FUNCTION
