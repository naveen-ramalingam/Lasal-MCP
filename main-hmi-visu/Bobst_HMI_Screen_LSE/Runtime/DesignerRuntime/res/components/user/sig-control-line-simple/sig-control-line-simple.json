        ------------------------------------------------------------------------------------------------------*/
        {
            "valueSourceTypes": [
                "constString"
            ],
            "name": "direction",
            "sortIndex": 500100,
            "default": "horizontal",
            "propertyType": "variable",
            "datatype": "string",
            "options": [
                {
                    "shortName": {
                        "en": "horizontal",
                        "de": "horizontal"
                    },
                    "value": "horizontal"
                },
                {
                    "shortName": {
                        "en": "vertical",
                        "de": "vertical"
                    },
                    "value": "vertical"
                },
                {
                    "shortName": {
                        "en": "top left to bottom right",
                        "de": "top left to bottom right"
                    },
                    "value": "topleftbotright"
                },
                {
                    "shortName": {
                        "en": "bottom left to top right",
                        "de": "bottom left to top right"
                    },
                    "value": "botlefttopright"
                }
            ],
            "shortName": {
                "en": "Direction",
                "de": "Direction"
            },
            "description": {
                "en": "The direction of the line",
                "de": "Die Richtung der Linie"
            },
            "group": {
                "en": "General styling",
                "de": "General styling"
            },
            "userLevel": 0,
            "userLevelStyling": 0,
            "tab": {
                "en": "Style",
                "de": "Style"
            },
            "tabIndex": 20
        },
        /*----------------------------------------------------------------------------------------------------
        // property Line width
        ------------------------------------------------------------------------------------------------------*/
        {
            "valueSourceTypes": [
                "constString"
            ],
            "name": "linewidth",
            "sortIndex": 500200,
            "propertyType": "variable",
            "datatype": "string",
            "units": "px",
            "default": "1px",
            "shortName": {
                "en": "Line width",
                "de": "Line width"
            },
            "description": {
                "en": "The width of the line",
                "de": "Die Linienstärke"
            },
            "group": {
                "en": "General styling",
                "de": "General styling"
            },
            "userLevel": 0,
            "userLevelStyling": 0,
            "tab": {
                "en": "Style",
                "de": "Style"
            },
            "tabIndex": 20
        }
