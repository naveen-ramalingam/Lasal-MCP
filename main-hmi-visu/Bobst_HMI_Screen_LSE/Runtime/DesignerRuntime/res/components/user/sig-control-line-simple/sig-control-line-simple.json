{
    "name": "sig-control-line-simple",
    "shortName": {
        "en": "Line Simple",
        "de": "Line Simple"
    },
    "controlType": {
        "en": "Drawing",
        "de": "Drawing"
    },
    "version": "02.00.000",
    "authors": [
        "SIGMATEK GmbH & Co KG"
    ],
    "description": {
        "en": "Implements a line as a polymer custom element.",
        "de": "Implementiert eine Linie als benutzerdefiniertes Polymer-Element."
    },
    "main": [
        "sig-control-line-simple.js"
    ],
    "moduleType": [
        "es6"
    ],
    "license": "http://www.sigmatek-automation.com/LICENSE.txt",
    "homepage": "http://www.sigmatek-automation.com/sig-control-line-simple.html",
    "private": true,
    "baseComponent": "sig-element-light",
    "dependencies": {
        "sig-element": "components/sigmatek/sig-element-light#^1.1.1",
        "polymer": "Polymer/polymer#^3.3.0"
    },
    "defaultDimensions": {
        "width": "100px",
        "height": "20px"
    },
    "resources": [
        {
            "designerAction": "addToPublish",
            "path": "./sig-control-line-simple-css.js"
        }
    ],
    "toolbox": true,
    "slotted": false,
    "styleClassEditor": true,
    "usableInShadowDom": true,
    "moduleImport": {
        "importType": "dynamic",
        "area": [
            "index",
            "designer",
            "designerToolbox"
        ],
        "section": "head",
        "position": "bottom"
    },
    "placementTemplates": [],
    "properties": [
        /*****************************************************************************************************
        // Hide properties from the base
        *****************************************************************************************************/
        {
            "valueSourceTypes": [
                "font",
                "fontScheme"
            ],
            "propertyType": "font",
            "name": "elementMainFont",
            "userLevel": -1,
            "userLevelStyling": -1
        },
        /*****************************************************************************************************
        // General styling
        *****************************************************************************************************/
		/*----------------------------------------------------------------------------------------------------
        // property Line color
        ------------------------------------------------------------------------------------------------------*/
        {
            "valueSourceTypes": [
                "color",
                "colorScheme"
            ],
            "name": "--theme-sig-control-line-simple-line-color",
            "sortIndex": 500000,
            "propertyType": "css",
            "datatype": "string",
            "default": "inherit",
            "shortName": {
                "en": "Line color",
                "de": "Line color"
            },
            "description": {
                "en": "The color of the line",
                "de": "Die Linienfarbe"
            },
            "group": {
                "en": "General styling",
                "de": "General styling"
            },
            "userLevel": 0,
            "userLevelStyling": 0,
            "tab": {
                "en": "Style",
                "de": "Style"
            },
            "tabIndex": 20
        },
