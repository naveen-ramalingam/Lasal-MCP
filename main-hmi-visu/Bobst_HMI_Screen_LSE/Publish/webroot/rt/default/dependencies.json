{
    "scripts": [
        {
            "id": "polyfill.js",
            "type": "system",
            "target": "head",
            "attributes": {
                "src": "@@RTPATH@@node_modules/babel-polyfill/polyfill.js",
                "type": "text/javascript",
                "crossorigin": "use-credentials"
            }
        },
        {
            "id": "webcomponents-loader.js",
            "type": "system",
            "target": "head",
            "attributes": {
                "src": "@@RTPATH@@node_modules/@webcomponents/webcomponentsjs/webcomponents-loader.js",
                "type": "text/javascript",
                "crossorigin": "use-credentials"
            }
        },
        {
            "id": "custom-style.js",
            "type": "system",
            "target": "head",
            "attributes": {
                "type": "module",
                "src": "@@RTPATH@@node_modules/@polymer/polymer/lib/elements/custom-style.js",
                "crossorigin": "use-credentials"
            }
        },
        {
            "id": "sig-base-css.js",
            "type": "system",
            "target": "head",
            "attributes": {
                "type": "module",
                "src": "@@RESPATH@@styles/sig-base-css.js",
                "crossorigin": "use-credentials"
            }
        },
        {
            "id": "sig-default-css.js",
            "type": "system",
            "target": "head",
            "attributes": {
                "type": "module",
                "src": "@@RESPATH@@styles/sig-default-css.js",
                "crossorigin": "use-credentials"
            }
        },
        {
            "id": "sig-project-fonts-css",
            "type": "system",
            "target": "head",
            "attributes": {
                "type": "module",
                "src": "@@RESPATH@@styles/sig-project-fonts-css.js",
                "crossorigin": "use-credentials"
            }
        },
        {
            "id": "sig-views-css.js",
            "type": "system",
            "target": "head",
            "attributes": {
                "type": "module",
                "src": "@@RESPATH@@styles/sig-views-css.js",
                "crossorigin": "use-credentials"
            }
        },
        {
            "id": "runtime-bundle.js",
            "type": "system",
            "target": "body",
            "attributes": {
                "src": "@@RTPATH@@scripts/runtime-bundle.js",
                "type": "text/javascript",
                "crossorigin": "use-credentials"
            }
        }
