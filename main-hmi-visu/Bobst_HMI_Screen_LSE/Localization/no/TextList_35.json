			"aliasName": "Text_26",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "176b7975-534f-4e9d-a940-663effb542c9",
			"aliasName": "Text_27",
			"text": "Start offset adjustment.|Move all frames to the left (left of the 0-position switch)|using the panel on the sub-PC. When all frames are|positioned, press \"Next step\" button to continue"
		},
		{
			"type": "textElement",
			"id": "e18edaae-263f-4bff-b515-d23d4195a5a9",
			"aliasName": "Text_28",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "7604aa6c-b839-4959-bd85-5e75e3508c5a",
			"aliasName": "Text_29",
			"text": "Measure each frame and enter the measured value in the corresponding field.|Press \"Next Step\" button to continue"
		},
		{
			"type": "textElement",
			"id": "8407676b-816c-41e7-8eed-d9f013a9d447",
			"aliasName": "Text_30",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "8c885393-588a-41db-a42f-ba60785a8c4c",
			"aliasName": "Text_31",
			"text": "Press the \"Start Offset\"button to start the offset procedure."
		},
		{
			"type": "textElement",
			"id": "731345e6-0d87-44c0-bc26-f679a7e48a30",
			"aliasName": "Text_32",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "35ac8070-1c86-432d-96c1-15d674be2404",
			"aliasName": "Text_33",
			"text": "Move frame per frame to the right side of the 0-position|switch. When a frame passes the 0-position switch, a|beep will sound. Keep the [+] button pressed until the|values on the display vary again, once they start change|again, release the [+] button and continue with next|frames until all frames are on the right side of the|0-position switch.||When all frames are repositioned, proceed to next step"
		},
		{
			"type": "textElement",
			"id": "c6c71278-4829-45e1-bdc4-b92798c35a68",
			"aliasName": "Text_34",
			"text": "Measurement of back and forth moving frames|of trombone frames and conveyor belt."
		},
		{
			"type": "textElement",
			"id": "23e746c8-50aa-4461-ab64-70c827942255",
			"aliasName": "Text_35",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "1044c3e3-9995-446f-ba25-0e541b8dea7c",
			"aliasName": "Text_36",
			"text": "Press \"End Offset\" to complete the process. The system will collect all values|and the machine will be ready for automatic positioning."
		},
		{
			"type": "textElement",
			"id": "b8f04eb5-8d79-49ed-9c96-7558bbbc5b36",
			"aliasName": "Text_37",
			"text": ""
		}
