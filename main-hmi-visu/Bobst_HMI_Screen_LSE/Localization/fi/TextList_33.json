{
	"type": "textList",
	"version": "0.0.96",
	"id": "ab91aaa5-0328-4f42-8ecb-72e2c3350856",
	"name": "TextList_33",
	"texts": [
		{
			"type": "textElement",
			"id": "142781b6-8803-44e5-aa7f-07a11936078c",
			"aliasName": "Text_0",
			"text": "Step1:"
		},
		{
			"type": "textElement",
			"id": "aa5da1e2-94dc-404e-8a8e-003ea77ab9b6",
			"aliasName": "Text_1",
			"text": "Bring all frames of all sections|to the left. Use the sub computer|panel to move a frame!"
		},
		{
			"type": "textElement",
			"id": "fbf0a377-9d8e-4c2a-9e07-098968d5f866",
			"aliasName": "Text_2",
			"text": "If all frames have been moved.|Go to next step."
		},
		{
			"type": "textElement",
			"id": "b8f1d99f-3cbc-401c-b7be-1db56a2df18c",
			"aliasName": "Text_3",
			"text": "Push Start Offset"
		},
		{
			"type": "textElement",
			"id": "fbd5ffa2-33f5-472c-913a-7f29ee5bbc1a",
			"aliasName": "Text_4",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "d45e0b20-c33a-4139-9507-2e066096dd34",
			"aliasName": "Text_5",
			"text": "Step2:"
		},
		{
			"type": "textElement",
			"id": "496e1c66-11fe-41f0-b33d-aafae699098c",
			"aliasName": "Text_6",
			"text": "Push the button \"Start Offset\" on the|right to start the Offset process."
		},
		{
			"type": "textElement",
			"id": "be79c78a-f7b0-4c92-b51c-09673bc4a682",
			"aliasName": "Text_7",
			"text": "Wait until the system is ready with|starting the Offset process."
		},
		{
			"type": "textElement",
			"id": "04687323-d185-4fa6-b6a2-8d643cfcf43c",
			"aliasName": "Text_8",
			"text": "If the Offset process has been started,|the speaker on the panel will |make a \"Beep\" sound."
		},
		{
			"type": "textElement",
			"id": "8a904827-b23d-47a4-b63b-8be2e2d2bbe5",
			"aliasName": "Text_9",
			"text": "The color of the pushed button will|also change to orange."
		},
		{
			"type": "textElement",
			"id": "200794a6-f27a-4cc7-9c17-e5bce8546690",
			"aliasName": "Text_10",
			"text": "Go to next step."
		},
		{
			"type": "textElement",
			"id": "ffef71ac-7c86-408c-90db-92fa44dfd957",
			"aliasName": "Text_11",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "d82ed760-933b-413b-857d-3a872a7cb4f9",
			"aliasName": "Text_12",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "7cfc6644-5158-4cf1-b545-38a349ab2593",
			"aliasName": "Text_13",
			"text": "Step3:"
		},
		{
			"type": "textElement",
			"id": "31214c6d-c7ac-4d45-a810-1e73f258c2a7",
			"aliasName": "Text_14",
			"text": "Now move all frames to the right."
		},
		{
			"type": "textElement",
			"id": "1ed545e0-0868-4dd0-8520-795dac54b0e1",
			"aliasName": "Text_15",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "9cb4a07e-4c3c-4180-8e91-7ba66d591243",
			"aliasName": "Text_16",
			"text": "Go to the next frame and repeat|the process."
		},
		{
			"type": "textElement",
			"id": "34a89d6d-02ac-4d7d-969f-4ef4dbafe05a",
			"aliasName": "Text_17",
			"text": "Push the button \"End Offset\"  if all|frames have been moved.|The system will then start to collect|the Offset values."
		}
	],
	"revision": {
		"type": "Revision",
		"revisionNr": "1.0"
	}
}