{
	"type": "textList",
	"version": "0.0.96",
	"id": "bfce78cc-e8d0-48c9-978c-e1c081379eb9",
	"name": "TextList_33",
	"texts": [
		{
			"type": "textElement",
			"id": "9947e79f-b43d-4c2a-9992-6cedc1189135",
			"aliasName": "Text_0",
			"text": "Step1:"
		},
		{
			"type": "textElement",
			"id": "187814f6-b974-4ff0-8e20-df4fd9214416",
			"aliasName": "Text_1",
			"text": "Bring all frames of all sections|to the left. Use the sub computer|panel to move a frame!"
		},
		{
			"type": "textElement",
			"id": "6dc5c33c-3b48-451b-bdd3-7f29a7caaa03",
			"aliasName": "Text_2",
			"text": "If all frames have been moved.|Go to next step."
		},
		{
			"type": "textElement",
			"id": "4a23b823-06c2-42ca-a2cf-565ed7f82132",
			"aliasName": "Text_3",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "371327d6-831d-43cb-84ac-b24180aedeb0",
			"aliasName": "Text_4",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "fe0984ce-8fbc-4614-acbe-bd7a55102a08",
			"aliasName": "Text_5",
			"text": "Step2:"
		},
		{
			"type": "textElement",
			"id": "4b8e1df0-3128-4a4f-b671-604861ac5d55",
			"aliasName": "Text_6",
			"text": "Push the button \"Start Offset\" on the|right to start the Offset process."
		},
		{
			"type": "textElement",
			"id": "0d889bfc-a1b3-4715-80eb-cecac648b019",
			"aliasName": "Text_7",
			"text": "Wait until the system is ready with|starting the Offset process."
		},
		{
			"type": "textElement",
			"id": "4a1bbf8f-73bd-4083-96fa-1903290242e3",
			"aliasName": "Text_8",
			"text": "If the Offset process has been started,|the speaker on the panel will |make a \"Beep\" sound."
		},
		{
			"type": "textElement",
			"id": "d2164b7c-0a4f-4c52-9afb-039362e4f72f",
			"aliasName": "Text_9",
			"text": "The color of the pushed button will|also change to orange."
		},
		{
			"type": "textElement",
			"id": "8fd947dd-2e8f-4458-aa8b-d72d3a283112",
			"aliasName": "Text_10",
			"text": "Go to next step."
		},
		{
			"type": "textElement",
			"id": "dc5a8042-b0b0-48f0-9eb7-014c5e97b455",
			"aliasName": "Text_11",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "16a56ee3-fe8e-4e8a-8eac-ebc9e8522533",
			"aliasName": "Text_12",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "5775b053-ebe1-49d5-9acb-7c07d66df544",
			"aliasName": "Text_13",
			"text": "Step3:"
		},
		{
			"type": "textElement",
			"id": "9723454a-6fd5-449d-81ec-fb26c73465b0",
			"aliasName": "Text_14",
			"text": "Now move all frames to the right.|One by one."
		},
		{
			"type": "textElement",
			"id": "072954db-a23f-44db-be28-a1aab1144092",
			"aliasName": "Text_15",
			"text": "While moving to the right, the frame|will past the \"Zero Limit Switch\".|At this point the panel will make|a \"Beep\" sound again."
		},
		{
			"type": "textElement",
			"id": "e57100cf-8b69-4f9f-8f59-2a58106af536",
			"aliasName": "Text_16",
			"text": "Go to the next frame and repeat|the process till the last frame."
		},
		{
			"type": "textElement",
			"id": "dc17a10f-2f69-4633-8fcb-d89d7f769fbb",
			"aliasName": "Text_17",
			"text": "Push the button \"End Offset\"  if all|frames have been moved.|The system will then start to collect|the Offset values."
		}
	],
	"revision": {
		"type": "Revision",
		"revisionNr": "1.0"
	}
}