{
	"type": "textList",
	"version": "0.0.96",
	"id": "0015909b-d3e7-4f21-9f83-029329408140",
	"name": "TextList_33",
	"texts": [
		{
			"type": "textElement",
			"id": "7eef9501-6963-47d5-a2d2-1e074d40a744",
			"aliasName": "Text_0",
			"text": "Step1:"
		},
		{
			"type": "textElement",
			"id": "a94bfbf4-16bc-44e6-a372-92228252f041",
			"aliasName": "Text_1",
			"text": "Bring all frames of all sections|to the left. Use the sub computer|panel to move a frame!"
		},
		{
			"type": "textElement",
			"id": "8764d1f6-fc6b-4210-abe5-631b635498a2",
			"aliasName": "Text_2",
			"text": "If all frames have been moved.|Go to next step."
		},
		{
			"type": "textElement",
			"id": "e8cc8b84-f8e5-4a98-82f7-f76e267c997f",
			"aliasName": "Text_3",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "32e0df4d-7022-4987-ac70-f4708f30de03",
			"aliasName": "Text_4",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "8980213c-272c-41b9-b279-27f7b10b4851",
			"aliasName": "Text_5",
			"text": "Step2:"
		},
		{
			"type": "textElement",
			"id": "cf4327ba-c05c-4366-8498-08d266b89355",
			"aliasName": "Text_6",
			"text": "Push the button \"Start Offset\" on the|right to start the Offset process."
		},
		{
			"type": "textElement",
			"id": "0ddf9b3d-0f0d-40cb-b0c7-ad4b6a6d78b8",
			"aliasName": "Text_7",
			"text": "Wait until the system is ready with|starting the Offset process."
		},
		{
			"type": "textElement",
			"id": "279a6570-0fff-4b05-ad68-a34cdd8577d3",
			"aliasName": "Text_8",
			"text": "If the Offset process has been started,|the speaker on the panel will |make a \"Beep\" sound."
		},
		{
			"type": "textElement",
			"id": "fe6bcd20-f293-4777-9ff8-bebf2bf4e1b1",
			"aliasName": "Text_9",
			"text": "The color of the pushed button will|also change to orange."
		},
		{
			"type": "textElement",
			"id": "0eb70f86-63d3-4e05-9d8b-4e2663b992ee",
			"aliasName": "Text_10",
			"text": "Go to next step."
		},
		{
			"type": "textElement",
			"id": "909c4b59-def7-496d-9b57-ba60f1eea98d",
			"aliasName": "Text_11",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "b056f9f5-3b89-40f3-8f37-288976639707",
			"aliasName": "Text_12",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "31a1011f-b1f0-480f-a3e7-ded2bd902798",
			"aliasName": "Text_13",
			"text": "Step3:"
		},
		{
			"type": "textElement",
			"id": "9fee24f6-7874-4f92-806d-4018f7f570ba",
			"aliasName": "Text_14",
			"text": "Now move all frames to the right.|One by one."
		},
		{
			"type": "textElement",
			"id": "66105e4d-8c99-42f9-860c-d044335081dd",
			"aliasName": "Text_15",
			"text": "While moving to the right, the frame|will past the \"Zero Limit Switch\".|At this point the panel will make|a \"Beep\" sound again."
		},
		{
			"type": "textElement",
			"id": "11b1006b-0af3-4f89-98c3-97246e23279e",
			"aliasName": "Text_16",
			"text": "Go to the next frame and repeat|the process till the last frame."
		},
		{
			"type": "textElement",
			"id": "99d94b8e-753e-42bf-b202-9f48761d423e",
			"aliasName": "Text_17",
			"text": "Push the button \"End Offset\"  if all|frames have been moved.|The system will then start to collect|the Offset values."
		}
	],
	"revision": {
		"type": "Revision",
		"revisionNr": "1.0"
	}
}