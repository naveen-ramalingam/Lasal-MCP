{
	"type": "textList",
	"version": "0.0.96",
	"id": "5f97fa79-e8f3-4a09-8ca6-dc0d31e4eafc",
	"name": "TextList_33",
	"texts": [
		{
			"type": "textElement",
			"id": "18c4bd5a-ec7b-453e-b6de-f7909a2b2ba8",
			"aliasName": "Text_0",
			"text": "Step1:"
		},
		{
			"type": "textElement",
			"id": "2b1f064e-6f8d-4798-8e95-ea5b2537ed7f",
			"aliasName": "Text_1",
			"text": "Bring all frames of all sections|to the left. Use the sub computer|panel to move a frame!"
		},
		{
			"type": "textElement",
			"id": "c0e82f33-0367-483b-86c5-14ff9b007e17",
			"aliasName": "Text_2",
			"text": "If all frames have been moved.|Go to next step."
		},
		{
			"type": "textElement",
			"id": "16db7991-035d-4b96-b14f-954af59c7a9f",
			"aliasName": "Text_3",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "5c35ab9f-1f66-4b2f-b4f6-baf84e6ad011",
			"aliasName": "Text_4",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "dab62056-0f35-47d8-95a4-9ceed58392a6",
			"aliasName": "Text_5",
			"text": "Step2:"
		},
		{
			"type": "textElement",
			"id": "022eb7f7-3609-4d89-afe7-0c4c3c663aa1",
			"aliasName": "Text_6",
			"text": "Push the button \"Start Offset\" on the|right to start the Offset process."
		},
		{
			"type": "textElement",
			"id": "a4dea582-9612-430e-b429-a17693bf679f",
			"aliasName": "Text_7",
			"text": "Wait until the system is ready with|starting the Offset process."
		},
		{
			"type": "textElement",
			"id": "632b56f3-1739-45c4-a46a-f4ff4a887726",
			"aliasName": "Text_8",
			"text": "If the Offset process has been started,|the speaker on the panel will |make a \"Beep\" sound."
		},
		{
			"type": "textElement",
			"id": "7bd49a60-5973-4ecc-8825-81300a323c73",
			"aliasName": "Text_9",
			"text": "The color of the pushed button will|also change to orange."
		},
		{
			"type": "textElement",
			"id": "959cde8d-92d1-4e55-962c-241e76103fa9",
			"aliasName": "Text_10",
			"text": "Go to next step."
		},
		{
			"type": "textElement",
			"id": "7829a8ed-f52e-475b-9882-721d58110018",
			"aliasName": "Text_11",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "07d85d77-8caf-41ca-8c3d-c5bff34a8cc7",
			"aliasName": "Text_12",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "8493c6bc-ffab-4873-b667-64a2f170bee6",
			"aliasName": "Text_13",
			"text": "Step3:"
		},
		{
			"type": "textElement",
			"id": "bafacaee-0dc0-4d0b-91f7-a6d883e455f2",
			"aliasName": "Text_14",
			"text": "Now move all frames to the right.|One by one."
		},
		{
			"type": "textElement",
			"id": "76570e21-4d05-4766-9b82-e06dac274c2e",
			"aliasName": "Text_15",
			"text": "While moving to the right, the frame|will past the \"Zero Limit Switch\".|At this point the panel will make|a \"Beep\" sound again."
		},
		{
			"type": "textElement",
			"id": "4a94100b-febd-448f-9574-957a52d605c8",
			"aliasName": "Text_16",
			"text": "Go to the next frame and repeat|the process till the last frame."
		},
		{
			"type": "textElement",
			"id": "6f4b6233-cfa2-4592-8774-e35f19c826b4",
			"aliasName": "Text_17",
			"text": "Push the button \"End Offset\"  if all|frames have been moved.|The system will then start to collect|the Offset values."
		}
	],
	"revision": {
		"type": "Revision",
		"revisionNr": "1.0"
	}
}