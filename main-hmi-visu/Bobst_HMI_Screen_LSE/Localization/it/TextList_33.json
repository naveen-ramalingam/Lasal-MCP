{
	"type": "textList",
	"version": "0.0.96",
	"id": "6872f392-ee1c-4b51-affe-4846f553be42",
	"name": "TextList_33",
	"texts": [
		{
			"type": "textElement",
			"id": "981b3849-8521-4ade-814f-578e0395a8d5",
			"aliasName": "Text_0",
			"text": "Step1:"
		},
		{
			"type": "textElement",
			"id": "eec1bb6a-a2d1-4a39-98e3-90fe10d1347b",
			"aliasName": "Text_1",
			"text": "Bring all frames of all sections|to the left. Use the sub computer|panel to move a frame!"
		},
		{
			"type": "textElement",
			"id": "fa790d47-d8ba-489e-8687-d6c61f4b0d09",
			"aliasName": "Text_2",
			"text": "If all frames have been moved.|Go to next step."
		},
		{
			"type": "textElement",
			"id": "d9321b2f-6f41-4ea2-bd99-a15d86c25c8b",
			"aliasName": "Text_3",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "21dcb4d7-0893-4cc2-9c71-856f5eabf8b6",
			"aliasName": "Text_4",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "2a86f51d-0a43-4b0a-8804-5ac398a68dd1",
			"aliasName": "Text_5",
			"text": "Step2:"
		},
		{
			"type": "textElement",
			"id": "fab29d97-4e21-4f71-a71e-4979279b9f9e",
			"aliasName": "Text_6",
			"text": "Push the button \"Start Offset\" on the|right to start the Offset process."
		},
		{
			"type": "textElement",
			"id": "b195c0d7-b5f3-4460-bf52-9960f5c74216",
			"aliasName": "Text_7",
			"text": "Wait until the system is ready with|starting the Offset process."
		},
		{
			"type": "textElement",
			"id": "be9d3e7a-f0c5-41e0-9afd-78b5e18ed9a0",
			"aliasName": "Text_8",
			"text": "If the Offset process has been started,|the speaker on the panel will |make a \"Beep\" sound."
		},
		{
			"type": "textElement",
			"id": "16cbb218-df74-4e75-aaf8-b85155b4b40f",
			"aliasName": "Text_9",
			"text": "The color of the pushed button will|also change to orange."
		},
		{
			"type": "textElement",
			"id": "58fe85ea-6407-4d87-be8d-e0d73bc4e3f5",
			"aliasName": "Text_10",
			"text": "Go to next step."
		},
		{
			"type": "textElement",
			"id": "dab8ef62-585b-4dd9-ba9d-6f1578d8ee9e",
			"aliasName": "Text_11",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "62289d13-512d-41fe-a632-f00e4bf254af",
			"aliasName": "Text_12",
			"text": ""
		},
		{
			"type": "textElement",
			"id": "f62be5a8-c5fb-43d9-bf4c-308667855596",
			"aliasName": "Text_13",
			"text": "Step3:"
		},
		{
			"type": "textElement",
			"id": "f2889dc1-9800-4261-b866-230d498add90",
			"aliasName": "Text_14",
			"text": "Now move all frames to the right.|One by one."
		},
		{
			"type": "textElement",
			"id": "eacf1d18-54e8-452d-903e-60c9dfbff090",
			"aliasName": "Text_15",
			"text": "While moving to the right, the frame|will past the \"Zero Limit Switch\".|At this point the panel will make|a \"Beep\" sound again."
		},
		{
			"type": "textElement",
			"id": "00fe3b07-855f-43a9-8ad0-1ba6e73bab4e",
			"aliasName": "Text_16",
			"text": "Go to the next frame and repeat|the process till the last frame."
		},
		{
			"type": "textElement",
			"id": "fa53cc71-d2fb-47c2-869b-6e229aee7366",
			"aliasName": "Text_17",
			"text": "Push the button \"End Offset\"  if all|frames have been moved.|The system will then start to collect|the Offset values."
		}
	],
	"revision": {
		"type": "Revision",
		"revisionNr": "1.0"
	}
}